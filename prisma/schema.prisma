// Reasons a job is paused. NOTE: WAITING_PARTS / WAITING_CUSTOMER are deliberately
// NOT pause reasons — they remain first-class ServiceOrderStatus states because
// parts-blocking carries distinct scheduling-eligibility semantics (CR-2026-001).
enum PauseReason {
  WAITING_TECH
  WAITING_BAY
  CUSTOMER_AUTHORIZATION
  EXTERNAL_MACHINE_SHOP
  BREAK_OR_END_OF_DAY
  OTHER
}

enum PartsRequestStatus {
  OPEN
  RESERVING
  PARTIAL
  READY
  TRANSFER_IN_PROGRESS
  RECEIVED
  CLOSED
  CANCELLED
}

enum TransferStatus {
  REQUESTED
  APPROVED
  IN_TRANSIT
  RECEIVED
  DELAYED
  CANCELLED
}

// DROPOFF = drop customer off at their destination (work, home, etc.)
// PICKUP = pick customer up and bring them back to the service centre
enum TransportDirection {
  DROPOFF
  PICKUP
}

enum TransportStatus {
  REQUESTED
  CONFIRMATION_PENDING
  SCHEDULED
  DRIVER_ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NotificationChannel {
  SMS
  EMAIL
  WHATSAPP
  MANUAL_CALL
}

enum NotificationDeliveryStatus {
  PENDING
  SCHEDULED
  SENT
  DELIVERED
  FAILED
  CANCELLED
  MANUAL
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  ON_ACCOUNT
  FAILED
  WAIVED
}

enum RecommendationConfidence {
  OEM
  VERIFIED
  NEEDS_CONFIRMATION
  ESTIMATE
}

enum DrivingProfile {
  NORMAL
  SEVERE
}

// --- v4.1 New Enums ---

enum ResourceCategory {
  BAY
  OVERFLOW
  LIGHT_SLOT
  POWER_WASH
  EXTERNAL
}

enum VehicleWeightClass {
  LIGHT
  STANDARD
  HEAVY
}

// DMAIC Rule 3: operational vehicle service class. Only SEDAN_CLASS is eligible
// for mobile jacks; everything else (incl. UNKNOWN) is blocked unless overridden.
//
// CR-2026-087 — reduced from seven members to two working classes plus the
// review state, at the owner's direction: the shop only distinguishes sedans
// from SUVs, and the per-category service times are defined for exactly those
// two. SUV_LIGHT, SUV_HEAVY, PICKUP, VAN and TRUCK were folded into SUV_CLASS
// (749 vehicles; there were no TRUCK rows).
//
// UNKNOWN_REQUIRES_REVIEW is deliberately KEPT. Rule 3 is fail-safe — anything
// not positively a sedan is mobile-jack blocked — so collapsing "never
// classified" into SUV_CLASS would still be safe for the jack gate, but it would
// make an unreviewed vehicle indistinguishable from a confirmed SUV and quietly
// empty the classification queue.
enum VehicleServiceClass {
  SEDAN_CLASS
  SUV_CLASS
  UNKNOWN_REQUIRES_REVIEW
}

// CR-2026-029: steering/drive side. Nullable on Vehicle — null means unknown.
enum DriveSide {
  RHD
  LHD
}

// CR-2026-008: vehicle ServiceClass classification workflow.
// Suggestions are advisory; the operational Vehicle.serviceClass is written
// ONLY after staff confirmation. Until CONFIRMED a vehicle stays mobile-jack
// blocked (DMAIC Rule 3 unchanged).
enum ClassificationStatus {
  PENDING_REVIEW
  CONFIRMED
}

enum ClassificationConfidence {
  HIGH
  MEDIUM
  LOW
  NONE
}

enum ClassificationSource {
  MAKE_MODEL_LOOKUP
  MANUAL
  CHECK_IN
}

enum IntegrationSystem {
  AUTOMATE
  SAGE
  SHAREPOINT_CONTACT_DB
  SHAREPOINT_JOB_SHEET
  TEST_DATA_RUN // CR-2026-020 — test-data run manifest tag (ExternalSystemRef)
}

enum ReminderStatus {
  SCHEDULED
  SENT
  ACKNOWLEDGED
  CANCELLED
  SUPERSEDED
}

enum ReminderConfidence {
  CONFIRMED
  ESTIMATED_HISTORY
  DEFAULT_INTERVAL
  OEM_SPEC
}

enum PartsReadinessState {
  NOT_REQUIRED
  UNCONFIRMED
  REQUIRED_NOT_READY
  READY
}

// =========================
// FOUNDATION
// =========================

model Site {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String   @unique
  name       String
  timezone   String   @default("America/Jamaica")
  /// CR-2026-089 — short, stable code used in queue ticket references (e.g. B01).
  /// Uppercase, 2-4 alphanumerics. Changing it never alters tickets already issued,
  /// because each ticket snapshots the code it was created under.
  ticketCode String?  @unique @map("ticket_code")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  userAccounts         UserAccount[]
  appointments         Appointment[]
  serviceVisits        ServiceVisit[]
  workBays             WorkBay[]
  workResources        WorkResource[]
  technicians          Technician[]
  businessRules        BusinessRuleConfig[]
  resourceReservations ResourceReservation[]
  scheduleHolds        ScheduleHold[] // CR-2026-026 — advisory schedule holds
  complaints           Complaint[] // CR-2026-032 — customer complaints
  inspections          VehicleInspection[] // CR-2026-034 — visual inspections

  // CR-2026-089 — per-day ticket sequence allocation.
  ticketCounters DailyTicketCounter[]

  @@map("sites")
}

// =========================
// CR-2026-026 — Schedule Quick-Book Holds (advisory only; NOT an appointment)
// A reserved time block with no customer/vehicle/service. Isolated from the
// scheduling engine (no queue/ETA/priority/bay/check-in). See
// docs/50_CR_2026_026_schedule_quick_book_holds.md.
// =========================
enum ScheduleHoldStatus {
  ACTIVE
  CONVERTED
  RELEASED
}

model ScheduleHold {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId                 String             @map("site_id") @db.Uuid
  scheduledStartAt       DateTime           @map("scheduled_start_at") @db.Timestamptz
  scheduledEndAt         DateTime           @map("scheduled_end_at") @db.Timestamptz // start + (30|60|90)
  status                 ScheduleHoldStatus @default(ACTIVE)
  label                  String? // optional short label
  notes                  String?
  // Soft reference (no relation) so the Appointment model is NOT modified.
  convertedAppointmentId String?            @unique @map("converted_appointment_id") @db.Uuid
  expiresAt              DateTime?          @map("expires_at") @db.Timestamptz // optional; manual release only in v1
  createdByUserId        String?            @map("created_by_user_id") @db.Uuid // soft ref (no FK)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  site Site @relation(fields: [siteId], references: [id])

  @@index([siteId, scheduledStartAt])
  @@index([status])
  @@map("schedule_holds")
}

// CR-2026-032 — Customer complaints log (new entity + audited state machine).
enum ComplaintStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum ComplaintType {
  SERVICE_QUALITY
  WAIT_TIME
  STAFF_CONDUCT
  PRICING
  VEHICLE_DAMAGE
  COMMUNICATION
  OTHER
}

enum ComplaintSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Complaint {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  complaintNumber      String            @unique @map("complaint_number") // immutable CMP-NNNNNN
  siteId               String            @map("site_id") @db.Uuid
  customerId           String            @map("customer_id") @db.Uuid
  serviceVisitId       String?           @map("service_visit_id") @db.Uuid // optional soft link
  serviceOrderId       String?           @map("service_order_id") @db.Uuid // optional; NO rework->complaint FK
  type                 ComplaintType
  severity             ComplaintSeverity @default(MEDIUM)
  status               ComplaintStatus   @default(OPEN)
  subject              String
  description          String
  slaDueAt             DateTime?         @map("sla_due_at") @db.Timestamptz // display/report only
  acknowledgedAt       DateTime?         @map("acknowledged_at") @db.Timestamptz
  acknowledgedByUserId String?           @map("acknowledged_by_user_id") @db.Uuid // soft ref (from JWT)
  resolvedAt           DateTime?         @map("resolved_at") @db.Timestamptz
  resolvedByUserId     String?           @map("resolved_by_user_id") @db.Uuid // soft ref (from JWT)
  resolutionNotes      String?           @map("resolution_notes") // required at resolve; manager-internal
  createdByUserId      String?           @map("created_by_user_id") @db.Uuid // soft ref (from JWT)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  site         Site          @relation(fields: [siteId], references: [id])
  customer     Customer      @relation(fields: [customerId], references: [id])
  serviceVisit ServiceVisit? @relation(fields: [serviceVisitId], references: [id])
  serviceOrder ServiceOrder? @relation(fields: [serviceOrderId], references: [id])

  @@index([siteId, status])
  @@index([customerId])
  @@index([status])
  @@index([serviceVisitId])
  @@index([serviceOrderId])
  @@map("complaints")
}

// CR-2026-034 — Digital Visual Inspection Form (template-driven; additive). C-1 = schema only.
enum InspectionStatus {
  DRAFT
  COMPLETED
  SIGNED_OFF
  CLOSED
  CANCELLED
}

enum InspectionItemResult {
  OK
  FUTURE
  IMMEDIATE
  NOT_APPLICABLE
}

enum BatteryTestResult {
  PASS
  RECHARGE_RETEST
  FAIL
}

enum WheelPosition {
  LEFT_FRONT
  RIGHT_FRONT
  LEFT_REAR
  RIGHT_REAR
}

enum RotorOrDrum {
  ROTOR
  DRUM
}

enum InspectionCustomerDecision {
  PENDING
  APPROVED
  DECLINED
  DEFERRED
}

enum RecommendationSeverity {
  FUTURE
  IMMEDIATE
}

enum InspectionSignatureRole {
  SENIOR_TECH
  CUSTOMER
}

enum InspectionSignatureType {
  TYPED
  DRAWN
}

// Versioned checklist source (seeded from docs/56). Each inspection snapshots the
// active template's items so historical inspections stay immutable.
model InspectionTemplate {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version   Int      @unique
  name      String
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  items       InspectionTemplateItem[]
  inspections VehicleInspection[]

  @@map("inspection_templates")
}

model InspectionTemplateItem {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId String  @map("template_id") @db.Uuid
  category   String
  label      String
  orderIndex Int     @map("order_index")
  allowsNa   Boolean @default(false) @map("allows_na")

  template InspectionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("inspection_template_items")
}

model VehicleInspection {
  id                       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inspectionNumber         String             @unique @map("inspection_number") // INS-NNNNNN
  siteId                   String             @map("site_id") @db.Uuid
  serviceVisitId           String             @map("service_visit_id") @db.Uuid
  vehicleId                String             @map("vehicle_id") @db.Uuid
  customerId               String             @map("customer_id") @db.Uuid
  templateId               String             @map("template_id") @db.Uuid
  templateVersion          Int                @map("template_version")
  status                   InspectionStatus   @default(DRAFT)
  performedByUserId        String?            @map("performed_by_user_id") @db.Uuid
  batteryTestResult        BatteryTestResult? @map("battery_test_result")
  batteryFactoryCca        Int?               @map("battery_factory_cca")
  batteryActualCca         Int?               @map("battery_actual_cca")
  alignmentCheckNeeded     Boolean            @default(false) @map("alignment_check_needed")
  wheelBalanceNeeded       Boolean            @default(false) @map("wheel_balance_needed")
  brakeInspectionPerformed Boolean            @default(true) @map("brake_inspection_performed")
  priorBodyDamageNotes     String?            @map("prior_body_damage_notes")
  comments                 String?
  signedOffByUserId        String?            @map("signed_off_by_user_id") @db.Uuid
  signedOffAt              DateTime?          @map("signed_off_at") @db.Timestamptz
  customerAckByUserId      String?            @map("customer_ack_by_user_id") @db.Uuid
  customerAckAt            DateTime?          @map("customer_ack_at") @db.Timestamptz
  // CR-2026-081 — additive lifecycle timestamps for accurate records/date filtering.
  // Nullable; historical rows stay null (reads fall back to signedOffAt/customerAckAt/createdAt).
  completedAt              DateTime?          @map("completed_at") @db.Timestamptz
  closedAt                 DateTime?          @map("closed_at") @db.Timestamptz
  createdByUserId          String?            @map("created_by_user_id") @db.Uuid
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  site         Site               @relation(fields: [siteId], references: [id], onDelete: Restrict)
  serviceVisit ServiceVisit       @relation(fields: [serviceVisitId], references: [id], onDelete: Restrict)
  vehicle      Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  customer     Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  template     InspectionTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  items             InspectionItem[]
  wheelMeasurements InspectionWheelMeasurement[]
  recommendations   InspectionRecommendation[]
  signatures        InspectionSignature[]
  photos            InspectionPhoto[]

  @@index([siteId, status])
  @@index([serviceVisitId])
  @@index([vehicleId])
  @@index([customerId])
  @@index([status])
  @@map("vehicle_inspections")
}

model InspectionItem {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inspectionId String               @map("inspection_id") @db.Uuid
  category     String
  label        String
  orderIndex   Int                  @map("order_index")
  result       InspectionItemResult @default(OK)
  note         String?

  inspection      VehicleInspection          @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  recommendations InspectionRecommendation[]

  @@index([inspectionId])
  @@map("inspection_items")
}

model InspectionWheelMeasurement {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inspectionId          String        @map("inspection_id") @db.Uuid
  position              WheelPosition
  brakeLiningMm         Float?        @map("brake_lining_mm")
  tireTread32nds        Int?          @map("tire_tread_32nds")
  wearPattern           String?       @map("wear_pattern")
  tirePressureBeforePsi Int?          @map("tire_pressure_before_psi")
  tirePressureAfterPsi  Int?          @map("tire_pressure_after_psi")
  rotorOrDrum           RotorOrDrum?  @map("rotor_or_drum")

  inspection VehicleInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@unique([inspectionId, position])
  @@index([inspectionId])
  @@map("inspection_wheel_measurements")
}

model InspectionRecommendation {
  id                          String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inspectionId                String                     @map("inspection_id") @db.Uuid
  inspectionItemId            String?                    @map("inspection_item_id") @db.Uuid
  severity                    RecommendationSeverity
  description                 String
  suggestedServiceTypeCode    String?                    @map("suggested_service_type_code")
  customerDecision            InspectionCustomerDecision @default(PENDING) @map("customer_decision")
  decisionByUserId            String?                    @map("decision_by_user_id") @db.Uuid
  decisionAt                  DateTime?                  @map("decision_at") @db.Timestamptz
  // Soft references (no FK) — set when an approved rec becomes work (C-5).
  resultingServiceOrderId     String?                    @map("resulting_service_order_id") @db.Uuid
  resultingServiceOrderItemId String?                    @map("resulting_service_order_item_id") @db.Uuid
  createdAt                   DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                   DateTime                   @updatedAt @map("updated_at") @db.Timestamptz

  inspection     VehicleInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  inspectionItem InspectionItem?   @relation(fields: [inspectionItemId], references: [id], onDelete: SetNull)

  @@index([inspectionId])
  @@map("inspection_recommendations")
}

model InspectionSignature {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inspectionId   String                  @map("inspection_id") @db.Uuid
  role           InspectionSignatureRole
  type           InspectionSignatureType
  typedName      String?                 @map("typed_name")
  imageData      String?                 @map("image_data") // base64 data-URL for DRAWN signatures
  signedByUserId String?                 @map("signed_by_user_id") @db.Uuid
  signedAt       DateTime                @default(now()) @map("signed_at") @db.Timestamptz

  inspection VehicleInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@unique([inspectionId, role])
  @@index([inspectionId])
  @@map("inspection_signatures")
}

model UserAccount {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId       String?  @map("site_id") @db.Uuid
  authSubject  String?  @unique @map("auth_subject")
  email        String?
  fullName     String   @map("full_name")
  roleCode     String   @map("role_code")
  passwordHash String?  @map("password_hash")
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  site Site? @relation(fields: [siteId], references: [id])

  createdAppointments     Appointment[]               @relation("AppointmentCreatedBy")
  createdBusinessRules    BusinessRuleConfig[]        @relation("RuleCreatedBy")
  auditLogs               AuditLog[]
  statusChanges           StatusHistory[]
  transportDriverJobs     TransportRequest[]          @relation("TransportDriver")
  overridesApplied        QueueTicket[]               @relation("OverrideAppliedBy")
  overridesCleared        QueueTicket[]               @relation("OverrideClearedBy")
  createdMaintenanceRecs  MaintenanceRecommendation[] @relation("MaintenanceRecCreatedBy")
  technician              Technician?
  queueEventActions       QueueEvent[]                @relation("QueueEventActor")
  initiatedNotifications  NotificationLog[]           @relation("NotificationInitiatedBy")
  reviewedClassifications VehicleClassification[]     @relation("ClassificationReviewedBy") // CR-2026-008

  @@map("user_accounts")
}

model Customer {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerNumber         String   @unique @map("customer_number")
  firstName              String   @map("first_name")
  lastName               String   @map("last_name")
  phone                  String
  email                  String?
  loyaltyNumber          String?  @map("loyalty_number") // CR-2026-050: deprecated, retained; loyalty is now a yes/no flag
  loyaltyMember          Boolean  @default(false) @map("loyalty_member")
  notificationOptInSms   Boolean  @default(true) @map("notification_opt_in_sms")
  notificationOptInEmail Boolean  @default(true) @map("notification_opt_in_email")
  notes                  String?
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz

  vehicles             Vehicle[]
  appointments         Appointment[]
  serviceVisits        ServiceVisit[]
  maintenanceReminders MaintenanceReminder[]
  complaints           Complaint[] // CR-2026-032 — customer complaints
  inspections          VehicleInspection[] // CR-2026-034 — visual inspections

  // CR-2026-020 — nullable test-data run tag (null for all real & imported rows)
  testDataRunId String?      @map("test_data_run_id") @db.Uuid
  testDataRun   TestDataRun? @relation(fields: [testDataRunId], references: [id], onDelete: Restrict)

  @@index([testDataRunId])
  @@map("customers")
}

model Vehicle {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId   String               @map("customer_id") @db.Uuid
  vehicleCode  String               @unique @map("vehicle_code") // "SC-{PLATE}" business reference
  plateNumber  String               @map("plate_number")
  vin          String?              @unique
  make         String?
  model        String?
  modelYear    Int?                 @map("model_year")
  color        String?
  odometer     Int?
  weightClass  VehicleWeightClass?  @map("weight_class")
  // DMAIC Rule 3: operational service class — drives mobile-jack eligibility (sedan only).
  serviceClass VehicleServiceClass? @map("service_class")
  // CR-2026-004: additive Contact-DB fields (nullable). engineNo is sensitive —
  // authenticated-only, never logged, never in public projections or dry-run reports.
  fuelType     String?              @map("fuel_type")
  transmission String?
  drivetrain   String?
  engineNo     String?              @map("engine_no")
  driveSide    DriveSide?           @map("drive_side")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  customer Customer @relation(fields: [customerId], references: [id])

  appointments               Appointment[]
  serviceVisits              ServiceVisit[]
  specSnapshots              VehicleSpecSnapshot[]
  fluidSpecs                 FluidSpecSnapshot[]
  maintenanceRecommendations MaintenanceRecommendation[]
  maintenanceReminders       MaintenanceReminder[]
  classification             VehicleClassification? // CR-2026-008
  inspections                VehicleInspection[] // CR-2026-034 — visual inspections

  // CR-2026-020 — nullable test-data run tag (null for all real & imported rows)
  testDataRunId String?      @map("test_data_run_id") @db.Uuid
  testDataRun   TestDataRun? @relation(fields: [testDataRunId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([plateNumber])
  @@index([testDataRunId])
  @@map("vehicles")
}

model ServiceType {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                     String   @unique
  name                     String
  family                   String
  baseDurationMinutes      Int      @map("base_duration_minutes")
  quickService             Boolean  @default(false) @map("quick_service")
  appointmentOnly          Boolean  @default(false) @map("appointment_only")
  requiredSkillCode        String?  @map("required_skill_code")
  requiredBayType          String?  @map("required_bay_type")
  partsPrepositionRequired Boolean  @default(false) @map("parts_preposition_required")
  transportEligible        Boolean  @default(false) @map("transport_eligible")
  batchingFamily           String?  @map("batching_family")
  // --- v4.1 Resource compatibility ---
  canUseOverflow           Boolean  @default(false) @map("can_use_overflow")
  canUseLightSlot          Boolean  @default(false) @map("can_use_light_slot")
  // --- DMAIC alignment ---
  requiresMileage          Boolean  @default(false) @map("requires_mileage")
  isExternal               Boolean  @default(false) @map("is_external")
  requiresPowerWash        Boolean  @default(false) @map("requires_power_wash")
  standPreferred           Boolean  @default(false) @map("stand_preferred")
