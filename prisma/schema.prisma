model ServiceOrder {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceVisitId         String             @map("service_visit_id") @db.Uuid
  advisorUserId          String?            @map("advisor_user_id") @db.Uuid
  status                 ServiceOrderStatus @default(DRAFT)
  promisedCompletionAt   DateTime?          @map("promised_completion_at") @db.Timestamptz
  paymentStatus          PaymentStatus      @default(UNPAID) @map("payment_status")
  startedAt              DateTime?          @map("started_at") @db.Timestamptz
  completedAt            DateTime?          @map("completed_at") @db.Timestamptz
  closedAt               DateTime?          @map("closed_at") @db.Timestamptz
  notes                  String?
  // CR-2026-087 — quality control. Previously a passed QC was an unattributed,
  // unguarded status transition: nothing recorded who did it, and nothing stopped
  // the technician who performed the work from passing their own. (A FAILED QC was
  // attributed via ServiceOrderRework.openedByUserId; a passed one was not.)
  //
  // qcAssignedTechnicianId is set in advance, when the job is assigned, so the shop
  // knows up front which senior technician owns the check.
  qcAssignedTechnicianId String?            @map("qc_assigned_technician_id") @db.Uuid
  qcByUserId             String?            @map("qc_by_user_id") @db.Uuid
  qcAt                   DateTime?          @map("qc_at") @db.Timestamptz
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  serviceVisit               ServiceVisit                @relation(fields: [serviceVisitId], references: [id])
  items                      ServiceOrderItem[]
  assignments                TechnicianAssignment[]
  partsRequests              PartsRequest[]
  posReferences              PosReference[]
  maintenanceRecommendations MaintenanceRecommendation[]
  pauses                     ServiceOrderPause[]
  reworks                    ServiceOrderRework[]
  complaints                 Complaint[] // CR-2026-032 — customer complaints
  // CR-2026-088 — technician KPI
  kpiSnapshot                WorkOrderKpiSnapshot?
  kpiDelayEvents             KpiDelayEvent[]
  workSegments               TechnicianWorkSegment[]

  @@index([serviceVisitId])
  @@index([status])
  @@map("service_orders")
}

// Append-only ledger of pause intervals for a service order (CR-2026-001).
// Pause DURATION is derived from these rows (sum of endedAt - startedAt), never
// stored as a mutable field. status=PAUSED on the order reflects an open row here.
model ServiceOrderPause {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceOrderId  String      @map("service_order_id") @db.Uuid
  reasonCode      PauseReason @map("reason_code")
  startedAt       DateTime    @default(now()) @map("started_at") @db.Timestamptz
  endedAt         DateTime?   @map("ended_at") @db.Timestamptz
  pausedByUserId  String?     @map("paused_by_user_id") @db.Uuid
  resumedByUserId String?     @map("resumed_by_user_id") @db.Uuid
  notes           String?
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz

  // CR-2026-100 — acknowledgement workflow. `startedAt` is ALWAYS the effective
  // moment labour stopped; approval records who acknowledged it and when, and
  // never moves the clock. A retro correction moves `startedAt` but preserves
  // the original in `originalStartedAt`, with actor + reason — timing records
  // are corrected in the open, never overwritten.
  technicianId     String?             @map("technician_id") @db.Uuid // whose labour stopped (snapshot)
  enteredOnBehalf  Boolean             @default(false) @map("entered_on_behalf") // recorded by advisor/manager, not the technician
  approvalStatus   PauseApprovalStatus @default(APPROVED) @map("approval_status")
  reviewedByUserId String?             @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime?           @map("reviewed_at") @db.Timestamptz
  reviewNotes      String?             @map("review_notes") // required on rejection
  originalStartedAt DateTime?          @map("original_started_at") @db.Timestamptz
  correctedByUserId String?            @map("corrected_by_user_id") @db.Uuid
  correctedAt       DateTime?          @map("corrected_at") @db.Timestamptz
  correctionReason  String?            @map("correction_reason")

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([serviceOrderId])
  @@index([approvalStatus])
  @@map("service_order_pauses")
}

// First-class rework (rectify) loop after a QC failure (CR-2026-001). Preserves
// original work history rather than overwriting it; reworkCount increments on repeats.
model ServiceOrderRework {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceOrderId String    @map("service_order_id") @db.Uuid
  reasonCode     String    @map("reason_code")
  description    String?
  reworkCount    Int       @default(1) @map("rework_count")
  openedAt       DateTime  @default(now()) @map("opened_at") @db.Timestamptz
  openedByUserId String?   @map("opened_by_user_id") @db.Uuid
  closedAt       DateTime? @map("closed_at") @db.Timestamptz
  closedByUserId String?   @map("closed_by_user_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([serviceOrderId])
  @@map("service_order_reworks")
}

model ServiceOrderItem {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceOrderId  String   @map("service_order_id") @db.Uuid
  serviceTypeId   String   @map("service_type_id") @db.Uuid
  estimateMinutes Int?     @map("estimate_minutes")
  actualMinutes   Int?     @map("actual_minutes")
  partsReadyFlag  Boolean  @default(false) @map("parts_ready_flag")
  status          String   @default("PLANNED")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  serviceType  ServiceType  @relation(fields: [serviceTypeId], references: [id])

  /// CR-2026-090 — which axle this line covers. Required for brake services where
  /// axle position decides the KPI package; null elsewhere.
  ///
  /// FRONT_AND_REAR is a legitimate booking, and the benchmark resolves it into TWO
  /// contributions rather than storing an ambiguous single one — front pads and rear
  /// shoes are different work with different allowances.
  axlePosition AxlePosition? @map("axle_position")

  /// CR-2026-092 — what brake work this line actually is. Brake family membership
  /// says nothing useful on its own: shoes are not front pads, and an inspection is
  /// not a repair.
  brakeWorkType BrakeWorkType? @map("brake_work_type")

  /// CR-2026-092 — what tyre work this line actually is. A pressure check is inside
  /// the General Service allowance; a replacement is additional work.
  tireOperation TireOperation? @map("tire_operation")

  /// Units where — and only where — the mapping's allowance basis is PER_UNIT.
  /// Never multiplies a PER_JOB allowance.
  unitQuantity Int? @map("unit_quantity")

  @@map("service_order_items")
}

model TechnicianAssignment {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceOrderId String    @map("service_order_id") @db.Uuid
  technicianId   String    @map("technician_id") @db.Uuid
  bayId          String?   @map("bay_id") @db.Uuid
  resourceId     String?   @map("resource_id") @db.Uuid // v4.1: parallel to bayId for WorkResource migration
  assignedAt     DateTime  @default(now()) @map("assigned_at") @db.Timestamptz
  startedAt      DateTime? @map("started_at") @db.Timestamptz
