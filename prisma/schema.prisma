// ExternalSystemRef(system=TEST_DATA_RUN) manifest. The run row is KEPT after
// cleanup (status=CLEANED_UP) for audit — never deleted by the runner, so the
// Restrict FK never blocks. createdByUserId is a soft reference (no DB FK).
// =========================

enum TestDataRunStatus {
  ACTIVE
  CLEANED_UP
}

// CR-2026-023 — discriminates batch test runs (scripts/test-data.ts) from
