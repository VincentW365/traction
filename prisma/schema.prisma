/// CR-2026-087 — pre-inspection vehicle photos, taken by the assigned technician
/// on their tablet.
///
/// Stored as a base64 data URL in a TEXT column, following the existing
/// InspectionSignature.imageData precedent. That is a deliberate trade: there is no
/// object store in this deployment and Render's free plan has NO persistent disk, so
/// anything written to the container filesystem is lost on every redeploy and cold
/// start. Keeping the bytes in Postgres is the only option that survives without
/// adding a third-party dependency.
///
/// The cost is database and backup size, so the client downscales before upload
/// (longest edge 1280px, JPEG) — a raw tablet photo is 1-5 MB and would both bloat
/// every row read and exceed the request body limit. Revisit an object store before
/// this becomes the shop's primary photographic record.
/// A photograph attached to an inspection.
///
/// CR-2026-093 moved the bytes OUT of this row. The original stored a whole JPEG as a
/// base64 data URL in a text column: every listing query dragged megabytes through the
/// database, the row could not be streamed, and nothing could be served with a
/// cacheable content type. The bytes now live behind a storage boundary and this row
/// carries only metadata — including a checksum, so a file that changes underneath is
/// detectable rather than silently trusted.
model InspectionPhoto {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inspectionId String @map("inspection_id") @db.Uuid

  /// Opaque key in the configured store. Never a URL and never guessable from the
  /// inspection number — photos are reached through an authorised endpoint, not by
  /// anyone who can count.
  storageKey String? @map("storage_key")

  originalFilename  String? @map("original_filename")
  sanitizedFilename String? @map("sanitized_filename")
  mimeType          String? @map("mime_type")
  byteSize          Int?    @map("byte_size")
  width             Int?
  height            Int?
  /// SHA-256 of the stored bytes.
  checksumSha256    String? @map("checksum_sha256") @db.Char(64)
  /// Thumbnail key, where the runtime could produce one.
  thumbnailKey      String? @map("thumbnail_key")

  category   InspectionPhotoCategory @default(OTHER)
  caption    String?
  sortOrder  Int                     @default(0) @map("sort_order")
  isPrimary  Boolean                 @default(false) @map("is_primary")

  /// Legacy base64 payload from before the storage boundary existed. Kept nullable and
  /// unread by new code so historical photographs stay viewable; never written again.
  imageData String? @map("image_data")

  takenByUserId    String?   @map("taken_by_user_id") @db.Uuid
  uploadedByUserId String?   @map("uploaded_by_user_id") @db.Uuid
  uploadedAt       DateTime? @map("uploaded_at") @db.Timestamptz

  /// Evidence is not edited in place after completion. A correction supersedes the
  /// original with a new row and a reason; the original stays, flagged, so the trail
  /// shows what was replaced and by whom rather than what someone wants it to say.
  supersedesPhotoId String?   @map("supersedes_photo_id") @db.Uuid
  supersededAt      DateTime? @map("superseded_at") @db.Timestamptz
  correctedByUserId String?   @map("corrected_by_user_id") @db.Uuid
  correctionReason  String?   @map("correction_reason")

  /// Soft removal, permitted only while the record is DRAFT.
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  deletedByUserId String?   @map("deleted_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  inspection VehicleInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@index([inspectionId, deletedAt])
  @@index([checksumSha256])
  @@map("inspection_photos")
}

