  checkinSequence      Int                @map("checkin_sequence")
  queueRank            Int?               @map("queue_rank")
  displayStatus        QueueDisplayStatus @default(PENDING_RANK) @map("display_status")
  generatedAt          DateTime           @default(now()) @map("generated_at") @db.Timestamptz
  lastRankedAt         DateTime?          @map("last_ranked_at") @db.Timestamptz
  // Override lifecycle fields
  overrideActive       Boolean            @default(false) @map("override_active")
  overrideReasonCode   String?            @map("override_reason_code")
  overrideAppliedBy    String?            @map("override_applied_by") @db.Uuid
  overrideAppliedAt    DateTime?          @map("override_applied_at") @db.Timestamptz
  overrideExpiresAt    DateTime?          @map("override_expires_at") @db.Timestamptz
  overrideClearedAt    DateTime?          @map("override_cleared_at") @db.Timestamptz
  overrideClearedBy    String?            @map("override_cleared_by") @db.Uuid
  overridePriorityMode String?            @map("override_priority_mode") // PIN_TO_RANK | PROMOTE_CLASS
  overrideRankPosition Int?               @map("override_rank_position")
  // --- v4.1 Dispatch readiness ---
  blockedReason        String?            @map("blocked_reason")
  readyForDispatch     Boolean            @default(false) @map("ready_for_dispatch")

  serviceVisit          ServiceVisit @relation(fields: [serviceVisitId], references: [id], onDelete: Cascade)
  overrideAppliedByUser UserAccount? @relation("OverrideAppliedBy", fields: [overrideAppliedBy], references: [id])
  overrideClearedByUser UserAccount? @relation("OverrideClearedBy", fields: [overrideClearedBy], references: [id])
  queueEvents           QueueEvent[]

  // CR-2026-089 — a sequence can never be issued twice for a location and day.
  @@unique([businessDate, dailySequence, locationCodeSnapshot])
  @@index([queueRank])
  @@index([displayStatus])
  @@map("queue_tickets")
}

