model NotificationLog {
  id                String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType        String                     @map("entity_type")
  entityId          String                     @map("entity_id") @db.Uuid
  channel           NotificationChannel
  templateKey       String                     @map("template_key")
  templateVersion   Int                        @default(1) @map("template_version")
  recipient         String
  status            NotificationDeliveryStatus @default(PENDING)
  providerReference String?                    @map("provider_reference")
  initiatedByUserId String?                    @map("initiated_by_user_id") @db.Uuid
  scheduledAt       DateTime?                  @map("scheduled_at") @db.Timestamptz
  sentAt            DateTime?                  @map("sent_at") @db.Timestamptz
  deliveredAt       DateTime?                  @map("delivered_at") @db.Timestamptz
  failureReason     String?                    @map("failure_reason")
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                   @updatedAt @map("updated_at") @db.Timestamptz

  // CR-2026-096 — unified customer notifications. All nullable/defaulted so legacy
  // rows and legacy send paths stay valid.
  reason            NotificationReason? // why this message went out (null on pre-CR rows)
  subject           String? // email subject exactly as sent
  body              String? // final message text exactly as sent (after staff edits)
  generatedBody     String?             @map("generated_body") // template output before staff edits
  intendedRecipient String?             @map("intended_recipient") // original recipient when test routing redirected
  testRouted        Boolean             @default(false) @map("test_routed") // TEST mode redirected this send
  simulated         Boolean             @default(false) @map("simulated") // no real provider configured; recorded only
  customerId        String?             @map("customer_id") @db.Uuid
  vehicleId         String?             @map("vehicle_id") @db.Uuid
  clientRequestId   String?             @unique @map("client_request_id") // idempotency key against double-click sends

  initiatedBy UserAccount? @relation("NotificationInitiatedBy", fields: [initiatedByUserId], references: [id])
  customer    Customer?    @relation("CustomerNotifications", fields: [customerId], references: [id])
  vehicle     Vehicle?     @relation("VehicleNotifications", fields: [vehicleId], references: [id])

  @@index([entityType, entityId])
  @@index([status])
  @@index([customerId])
  @@index([vehicleId])
  @@map("notification_logs")
}

// CR-2026-096 — admin-editable notification templates. Wording lives here (not in
// code) so managers change it without redeployment. Version increments on every
// edit; sent messages snapshot their final text on NotificationLog, so editing a
// template never rewrites history.
model NotificationTemplate {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key             String              @unique // e.g. SERVICE_DUE_SMS
  reason          NotificationReason
  channel         NotificationChannel
  name            String // human label shown in admin UI
  subject         String? // email templates only
  body            String
  enabled         Boolean             @default(true)
  version         Int                 @default(1)
  updatedByUserId String?             @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  updatedBy UserAccount? @relation("NotificationTemplateUpdatedBy", fields: [updatedByUserId], references: [id])

  @@index([reason])
  @@map("notification_templates")
}

