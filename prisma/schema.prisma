// =========================
// v4.1 — WORK RESOURCES (alongside WorkBay, migration-safe)
// =========================

model WorkResource {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId              String              @map("site_id") @db.Uuid
  code                String
  name                String
  // --- Structured core fields (queried, filtered, used in dispatch logic) ---
  resourceCategory    ResourceCategory    @map("resource_category")
  maxVehicleWeight    VehicleWeightClass? @map("max_vehicle_weight")
  liftType            String?             @map("lift_type") // "heavy", "sedan", "mobile", "power_jack", null
  hasAlignment        Boolean             @default(false) @map("has_alignment")
  hasDiagnostics      Boolean             @default(false) @map("has_diagnostics")
  requiresMechanic    Boolean             @default(true) @map("requires_mechanic")
  showOnDispatchBoard Boolean             @default(true) @map("show_on_dispatch_board")
  isActive            Boolean             @default(true) @map("is_active")
  displayOrder        Int                 @default(0) @map("display_order")
  // CR-2026-095 — vehicle-class compatibility, stored structured rather than
  // inferred from names. The platform's operational classes are Sedan and SUV; a
  // resource may support either or both.
  supportsSedan       Boolean             @default(true) @map("supports_sedan")
  supportsSuv         Boolean             @default(true) @map("supports_suv")
  /// May the scheduler hand this resource new work at all? Distinct from the
  /// operational state: a spare jack can be AVAILABLE yet held out of scheduling.
  schedulingEnabled   Boolean             @default(true) @map("scheduling_enabled")
  capacity            Int                 @default(1)
  // Retirement is permanent lifecycle, never deleted: historical assignments keep
  // pointing here, and reports keep resolving the name.
  retiredAt           DateTime?           @map("retired_at") @db.Timestamptz
  retiredByUserId     String?             @map("retired_by_user_id") @db.Uuid
  retireReason        String?             @map("retire_reason")
  // --- JSON extensible flags (secondary, future-proofing) ---
  capabilities        Json?
  notes               String?
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  site              Site                       @relation(fields: [siteId], references: [id])
  occupancy         ResourceOccupancy?
  reservations      ResourceReservation[]
  assignments       TechnicianAssignment[]
  operationalStatus ResourceOperationalStatus?

  @@unique([siteId, code])
  @@map("work_resources")
}

