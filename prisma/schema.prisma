// Bert's Service Operations Platform — Prisma Schema
// Translated from db/schema_outline.sql + maintenance intelligence delta + override lifecycle delta
// All 32 tables + 14 enums

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================
// ENUMS
// =========================

enum AppointmentStatus {
  DRAFT
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  MISSED
  CANCELLED
  RESCHEDULED
}

enum ServiceVisitStatus {
  CREATED
  ARRIVED
  CHECKED_IN
  QUEUED
  CALLED
  IN_SERVICE
  WAITING_PARTS
  QC
  READY_FOR_PICKUP
  CLOSED
  ABANDONED
  CANCELLED
}

enum QueueDisplayStatus {
  PENDING_RANK
  ISSUED
  WAITING
  CALLED
  IN_SERVICE
  BLOCKED
  COMPLETED
  CANCELLED
}

enum VisitSourceType {
  APPOINTMENT
  WALKIN
  HISTORICAL_IMPORT
}

enum QueuePriorityClass {
  APPT_PROTECTED
  APPT_LATE_SOFT
  WALKIN_STANDARD
  WALKIN_FASTTRACK
  BLOCKED_PARTS
  BLOCKED_SKILL
  MISSED_APPOINTMENT
  MANUAL_OVERRIDE
}

enum ServiceOrderStatus {
  DRAFT
  APPROVED
  ASSIGNED
  IN_PROGRESS
  PAUSED
  WAITING_PARTS
  WAITING_CUSTOMER
  QC
  READY_TO_INVOICE
  CLOSED
  CANCELLED
}

// Reasons a job is paused. NOTE: WAITING_PARTS / WAITING_CUSTOMER are deliberately
// NOT pause reasons — they remain first-class ServiceOrderStatus states because
// parts-blocking carries distinct scheduling-eligibility semantics (CR-2026-001).
enum PauseReason {
  WAITING_TECH
  WAITING_BAY
  CUSTOMER_AUTHORIZATION
  EXTERNAL_MACHINE_SHOP
  BREAK_OR_END_OF_DAY
  OTHER
}

enum PartsRequestStatus {
  OPEN
  RESERVING
  PARTIAL
  READY
  TRANSFER_IN_PROGRESS
  RECEIVED
  CLOSED
  CANCELLED
}

enum TransferStatus {
  REQUESTED
  APPROVED
  IN_TRANSIT
  RECEIVED
  DELAYED
  CANCELLED
}

// DROPOFF = drop customer off at their destination (work, home, etc.)
// PICKUP = pick customer up and bring them back to the service centre
enum TransportDirection {
  DROPOFF
  PICKUP
}

enum TransportStatus {
  REQUESTED
  CONFIRMATION_PENDING
  SCHEDULED
  DRIVER_ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NotificationChannel {
  SMS
  EMAIL
  WHATSAPP
  MANUAL_CALL
}

enum NotificationDeliveryStatus {
  PENDING
  SCHEDULED
  SENT
  DELIVERED
  FAILED
  CANCELLED
  MANUAL
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  ON_ACCOUNT
  FAILED
  WAIVED
}

enum RecommendationConfidence {
  OEM
  VERIFIED
  NEEDS_CONFIRMATION
  ESTIMATE
}

enum DrivingProfile {
  NORMAL
  SEVERE
}

// --- v4.1 New Enums ---

enum ResourceCategory {
  BAY
  OVERFLOW
  LIGHT_SLOT
  POWER_WASH
  EXTERNAL
}

enum VehicleWeightClass {
  LIGHT
  STANDARD
  HEAVY
}

// DMAIC Rule 3: operational vehicle service class. Only SEDAN_CLASS is eligible
// for mobile jacks; everything else (incl. UNKNOWN) is blocked unless overridden.
enum VehicleServiceClass {
  SEDAN_CLASS
  SUV_LIGHT
  SUV_HEAVY
  PICKUP
  VAN
  TRUCK
  UNKNOWN_REQUIRES_REVIEW
}

enum IntegrationSystem {
  AUTOMATE
  SAGE
  SHAREPOINT_CONTACT_DB
  SHAREPOINT_JOB_SHEET
}

enum ReminderStatus {
  SCHEDULED
  SENT
  ACKNOWLEDGED
  CANCELLED
  SUPERSEDED
}

enum ReminderConfidence {
  CONFIRMED
  ESTIMATED_HISTORY
  DEFAULT_INTERVAL
  OEM_SPEC
}

enum PartsReadinessState {
  NOT_REQUIRED
  UNCONFIRMED
  REQUIRED_NOT_READY
  READY
}

// =========================
// FOUNDATION
// =========================

model Site {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique
  name      String
  timezone  String   @default("America/Jamaica")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  userAccounts         UserAccount[]
  appointments         Appointment[]
  serviceVisits        ServiceVisit[]
  workBays             WorkBay[]
  workResources        WorkResource[]
  technicians          Technician[]
  businessRules        BusinessRuleConfig[]
  resourceReservations ResourceReservation[]

  @@map("sites")
}

model UserAccount {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId       String?  @map("site_id") @db.Uuid
  authSubject  String?  @unique @map("auth_subject")
  email        String?
  fullName     String   @map("full_name")
  roleCode     String   @map("role_code")
  passwordHash String?  @map("password_hash")
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  site Site? @relation(fields: [siteId], references: [id])

  createdAppointments      Appointment[]              @relation("AppointmentCreatedBy")
  createdBusinessRules     BusinessRuleConfig[]        @relation("RuleCreatedBy")
  auditLogs                AuditLog[]
  statusChanges            StatusHistory[]
  transportDriverJobs      TransportRequest[]          @relation("TransportDriver")
  overridesApplied         QueueTicket[]               @relation("OverrideAppliedBy")
  overridesCleared         QueueTicket[]               @relation("OverrideClearedBy")
  createdMaintenanceRecs   MaintenanceRecommendation[] @relation("MaintenanceRecCreatedBy")
  technician               Technician?
  queueEventActions        QueueEvent[]                @relation("QueueEventActor")
  initiatedNotifications   NotificationLog[]           @relation("NotificationInitiatedBy")

  @@map("user_accounts")
}

model Customer {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerNumber         String   @unique @map("customer_number")
  firstName              String   @map("first_name")
  lastName               String   @map("last_name")
  phone                  String
  email                  String?
  loyaltyNumber          String?  @map("loyalty_number")
  notificationOptInSms   Boolean  @default(true) @map("notification_opt_in_sms")
  notificationOptInEmail Boolean  @default(true) @map("notification_opt_in_email")
  notes                  String?
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz

  vehicles             Vehicle[]
  appointments         Appointment[]
  serviceVisits        ServiceVisit[]
  maintenanceReminders MaintenanceReminder[]

  @@map("customers")
}

model Vehicle {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String              @map("customer_id") @db.Uuid
  vehicleCode String              @unique @map("vehicle_code") // "SC-{PLATE}" business reference
  plateNumber String              @map("plate_number")
  vin         String?             @unique
  make        String?
  model       String?
  modelYear   Int?                @map("model_year")
  color       String?
  odometer    Int?
  weightClass VehicleWeightClass? @map("weight_class")
  // DMAIC Rule 3: operational service class — drives mobile-jack eligibility (sedan only).
  serviceClass VehicleServiceClass? @map("service_class")
  // CR-2026-004: additive Contact-DB fields (nullable). engineNo is sensitive —
  // authenticated-only, never logged, never in public projections or dry-run reports.
  fuelType     String?             @map("fuel_type")
  transmission String?
  drivetrain   String?
  engineNo     String?             @map("engine_no")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  customer Customer @relation(fields: [customerId], references: [id])

  appointments               Appointment[]
  serviceVisits              ServiceVisit[]
  specSnapshots              VehicleSpecSnapshot[]
  fluidSpecs                 FluidSpecSnapshot[]
  maintenanceRecommendations MaintenanceRecommendation[]
  maintenanceReminders       MaintenanceReminder[]

  @@index([customerId])
  @@index([plateNumber])
  @@map("vehicles")
}

model ServiceType {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                     String   @unique
  name                     String
  family                   String
  baseDurationMinutes      Int      @map("base_duration_minutes")
  quickService             Boolean  @default(false) @map("quick_service")
  appointmentOnly          Boolean  @default(false) @map("appointment_only")
  requiredSkillCode        String?  @map("required_skill_code")
  requiredBayType          String?  @map("required_bay_type")
  partsPrepositionRequired Boolean  @default(false) @map("parts_preposition_required")
  transportEligible        Boolean  @default(false) @map("transport_eligible")
  batchingFamily           String?  @map("batching_family")
  // --- v4.1 Resource compatibility ---
  canUseOverflow           Boolean  @default(false) @map("can_use_overflow")
  canUseLightSlot          Boolean  @default(false) @map("can_use_light_slot")
  // --- DMAIC alignment ---
  requiresMileage          Boolean  @default(false) @map("requires_mileage")
  isExternal               Boolean  @default(false) @map("is_external")
  requiresPowerWash        Boolean  @default(false) @map("requires_power_wash")
  standPreferred           Boolean  @default(false) @map("stand_preferred")
  mobileJackAllowed        Boolean  @default(true)  @map("mobile_jack_allowed")
  isActive                 Boolean  @default(true) @map("is_active")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz

  appointmentServices AppointmentService[]
  serviceOrderItems   ServiceOrderItem[]

  @@map("service_types")
}

model BusinessRuleConfig {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId          String?   @map("site_id") @db.Uuid
  ruleKey         String    @map("rule_key")
  valueJson       Json      @map("value_json")
  effectiveFrom   DateTime  @default(now()) @map("effective_from") @db.Timestamptz
  effectiveTo     DateTime? @map("effective_to") @db.Timestamptz
  notes           String?
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  site      Site?        @relation(fields: [siteId], references: [id])
  createdBy UserAccount? @relation("RuleCreatedBy", fields: [createdByUserId], references: [id])

  @@index([ruleKey])
  @@index([siteId])
  @@map("business_rule_configs")
}

// =========================
// APPOINTMENTS / VISITS / QUEUE
// =========================

model Appointment {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId             String            @map("site_id") @db.Uuid
  customerId         String            @map("customer_id") @db.Uuid
  vehicleId          String            @map("vehicle_id") @db.Uuid
  scheduledStartAt   DateTime          @map("scheduled_start_at") @db.Timestamptz
  scheduledEndAt     DateTime?         @map("scheduled_end_at") @db.Timestamptz
  status             AppointmentStatus @default(DRAFT)
  confirmationStatus String?           @default("PENDING") @map("confirmation_status")
  sourceChannel      String?           @default("STAFF") @map("source_channel")
  notes              String?
  createdByUserId    String?           @map("created_by_user_id") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  site      Site         @relation(fields: [siteId], references: [id])
  customer  Customer     @relation(fields: [customerId], references: [id])
  vehicle   Vehicle      @relation(fields: [vehicleId], references: [id])
  createdBy UserAccount? @relation("AppointmentCreatedBy", fields: [createdByUserId], references: [id])

  services             AppointmentService[]
  serviceVisit         ServiceVisit?
  resourceReservations ResourceReservation[]

  @@index([siteId, scheduledStartAt])
  @@index([status])
  @@map("appointments")
}

model AppointmentService {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appointmentId  String   @map("appointment_id") @db.Uuid
  serviceTypeId  String   @map("service_type_id") @db.Uuid
  qty            Int      @default(1)
  requestedNotes String?  @map("requested_notes")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceType ServiceType @relation(fields: [serviceTypeId], references: [id])

  @@map("appointment_services")
}

model ServiceVisit {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId               String              @map("site_id") @db.Uuid
  customerId           String              @map("customer_id") @db.Uuid
  vehicleId            String              @map("vehicle_id") @db.Uuid
  appointmentId        String?             @unique @map("appointment_id") @db.Uuid
  sourceType           VisitSourceType     @map("source_type")
  arrivalAt            DateTime?           @map("arrival_at") @db.Timestamptz
  checkInStartedAt     DateTime?           @map("check_in_started_at") @db.Timestamptz
  checkedInAt          DateTime?           @map("checked_in_at") @db.Timestamptz
  status               ServiceVisitStatus  @default(CREATED)
  queuePriorityClass   QueuePriorityClass? @map("queue_priority_class")
  currentEtaStartAt    DateTime?           @map("current_eta_start_at") @db.Timestamptz
  currentEtaCompleteAt DateTime?           @map("current_eta_complete_at") @db.Timestamptz
  notes                String?
  // --- v4.1 Intake fields (replaces SharePoint capture) ---
  mileageIn            Int?                @map("mileage_in")
  mileageOut           Int?                @map("mileage_out")
  oilBrandRequested    String?             @map("oil_brand_requested")
  oilGradeRequested    String?             @map("oil_grade_requested")
  oilBrandInstalled    String?             @map("oil_brand_installed")
  oilGradeInstalled    String?             @map("oil_grade_installed")
  // --- v4.1 Parts readiness (derived projection from PartsRequest/Item) ---
  partsReadiness       PartsReadinessState @default(NOT_REQUIRED) @map("parts_readiness")
  // --- v4.1 Customer transparency ---
  customerStatusToken  String?             @unique @map("customer_status_token")
  tokenExpiresAt       DateTime?           @map("token_expires_at") @db.Timestamptz
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  site        Site         @relation(fields: [siteId], references: [id])
  customer    Customer     @relation(fields: [customerId], references: [id])
  vehicle     Vehicle      @relation(fields: [vehicleId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  queueTicket                QueueTicket?
  queueDecisions             QueueDecision[]
  queueEvents                QueueEvent[]
  serviceOrders              ServiceOrder[]
  transportRequests          TransportRequest[]
  maintenanceRecommendations MaintenanceRecommendation[]
  resourceOccupancies        ResourceOccupancy[]

  @@index([siteId, status])
  @@index([customerId, vehicleId])
  @@map("service_visits")
}

model QueueTicket {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceVisitId        String             @unique @map("service_visit_id") @db.Uuid
  ticketNumber          String             @unique @map("ticket_number")
  checkinSequence       Int                @map("checkin_sequence")
  queueRank             Int?               @map("queue_rank")
  displayStatus         QueueDisplayStatus @default(PENDING_RANK) @map("display_status")
  generatedAt           DateTime           @default(now()) @map("generated_at") @db.Timestamptz
  lastRankedAt          DateTime?          @map("last_ranked_at") @db.Timestamptz
  // Override lifecycle fields
  overrideActive        Boolean            @default(false) @map("override_active")
  overrideReasonCode    String?            @map("override_reason_code")
  overrideAppliedBy     String?            @map("override_applied_by") @db.Uuid
  overrideAppliedAt     DateTime?          @map("override_applied_at") @db.Timestamptz
  overrideExpiresAt     DateTime?          @map("override_expires_at") @db.Timestamptz
  overrideClearedAt     DateTime?          @map("override_cleared_at") @db.Timestamptz
  overrideClearedBy     String?            @map("override_cleared_by") @db.Uuid
  overridePriorityMode  String?            @map("override_priority_mode") // PIN_TO_RANK | PROMOTE_CLASS
  overrideRankPosition  Int?               @map("override_rank_position")
  // --- v4.1 Dispatch readiness ---
  blockedReason         String?            @map("blocked_reason")
  readyForDispatch      Boolean            @default(false) @map("ready_for_dispatch")

  serviceVisit          ServiceVisit  @relation(fields: [serviceVisitId], references: [id], onDelete: Cascade)
  overrideAppliedByUser UserAccount?  @relation("OverrideAppliedBy", fields: [overrideAppliedBy], references: [id])
  overrideClearedByUser UserAccount?  @relation("OverrideClearedBy", fields: [overrideClearedBy], references: [id])
  queueEvents           QueueEvent[]

  @@index([queueRank])
  @@index([displayStatus])
  @@map("queue_tickets")
}

model QueueDecision {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceVisitId         String             @map("service_visit_id") @db.Uuid
  snapshotAt             DateTime           @default(now()) @map("snapshot_at") @db.Timestamptz
  priorityClass          QueuePriorityClass @map("priority_class")
  score                  Decimal?           @db.Decimal(12, 2)
  blockedReason          String?            @map("blocked_reason")
  reasonCodes            Json               @default("[]") @map("reason_codes")
  candidateTechnicianIds Json?              @map("candidate_technician_ids")
  candidateBayIds        Json?              @map("candidate_bay_ids")
  etaStartAt             DateTime?          @map("eta_start_at") @db.Timestamptz
  etaCompleteAt          DateTime?          @map("eta_complete_at") @db.Timestamptz

  serviceVisit ServiceVisit @relation(fields: [serviceVisitId], references: [id], onDelete: Cascade)

  @@index([serviceVisitId, snapshotAt(sort: Desc)])
  @@map("queue_decisions")
}

model QueueEvent {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceVisitId  String   @map("service_visit_id") @db.Uuid
  queueTicketId   String   @map("queue_ticket_id") @db.Uuid
  eventType       String   @map("event_type")
  positionBefore  Int?     @map("position_before")
  positionAfter   Int?     @map("position_after")
  reasonCode      String?  @map("reason_code")
  actorUserId     String?  @map("actor_user_id") @db.Uuid
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  serviceVisit ServiceVisit @relation(fields: [serviceVisitId], references: [id], onDelete: Cascade)
  queueTicket  QueueTicket  @relation(fields: [queueTicketId], references: [id], onDelete: Cascade)
  actor        UserAccount? @relation("QueueEventActor", fields: [actorUserId], references: [id])

  @@index([serviceVisitId, createdAt(sort: Desc)])
  @@index([queueTicketId])
  @@map("queue_events")
}

// =========================
// TECHNICIANS / BAYS / SERVICE ORDERS
// =========================

model Technician {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userAccountId String   @unique @map("user_account_id") @db.Uuid
  employeeCode  String   @unique @map("employee_code")
  homeSiteId    String?  @map("home_site_id") @db.Uuid
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  userAccount  UserAccount               @relation(fields: [userAccountId], references: [id])
  homeSite     Site?                     @relation(fields: [homeSiteId], references: [id])
  skills       TechnicianSkill[]
  assignments  TechnicianAssignment[]
  availability MechanicDayAvailability[]

  @@map("technicians")
}

model TechnicianSkill {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  technicianId     String   @map("technician_id") @db.Uuid
  skillCode        String   @map("skill_code")
  proficiencyLevel Int      @default(1) @map("proficiency_level")
  isPrimary        Boolean  @default(false) @map("is_primary")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  technician Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@unique([technicianId, skillCode])
  @@map("technician_skills")
}

model WorkBay {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId    String   @map("site_id") @db.Uuid
  code      String
  bayType   String   @map("bay_type")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  site        Site                   @relation(fields: [siteId], references: [id])
  assignments TechnicianAssignment[]

  @@unique([siteId, code])
  @@map("work_bays")
}

model ServiceOrder {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceVisitId        String             @map("service_visit_id") @db.Uuid
  advisorUserId         String?            @map("advisor_user_id") @db.Uuid
  status                ServiceOrderStatus @default(DRAFT)
  promisedCompletionAt  DateTime?          @map("promised_completion_at") @db.Timestamptz
  paymentStatus         PaymentStatus      @default(UNPAID) @map("payment_status")
  startedAt             DateTime?          @map("started_at") @db.Timestamptz
  completedAt           DateTime?          @map("completed_at") @db.Timestamptz
  closedAt              DateTime?          @map("closed_at") @db.Timestamptz
  notes                 String?
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  serviceVisit               ServiceVisit              @relation(fields: [serviceVisitId], references: [id])
  items                      ServiceOrderItem[]
  assignments                TechnicianAssignment[]
  partsRequests              PartsRequest[]
  posReferences              PosReference[]
  maintenanceRecommendations MaintenanceRecommendation[]
  pauses                     ServiceOrderPause[]
  reworks                    ServiceOrderRework[]

  @@index([serviceVisitId])
  @@index([status])
  @@map("service_orders")
}

// Append-only ledger of pause intervals for a service order (CR-2026-001).
// Pause DURATION is derived from these rows (sum of endedAt - startedAt), never
// stored as a mutable field. status=PAUSED on the order reflects an open row here.
model ServiceOrderPause {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceOrderId  String      @map("service_order_id") @db.Uuid
  reasonCode      PauseReason @map("reason_code")
  startedAt       DateTime    @default(now()) @map("started_at") @db.Timestamptz
  endedAt         DateTime?   @map("ended_at") @db.Timestamptz
  pausedByUserId  String?     @map("paused_by_user_id") @db.Uuid
  resumedByUserId String?     @map("resumed_by_user_id") @db.Uuid
  notes           String?
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([serviceOrderId])
  @@map("service_order_pauses")
}

// First-class rework (rectify) loop after a QC failure (CR-2026-001). Preserves
// original work history rather than overwriting it; reworkCount increments on repeats.
model ServiceOrderRework {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceOrderId String    @map("service_order_id") @db.Uuid
  reasonCode     String    @map("reason_code")
  description    String?
  reworkCount    Int       @default(1) @map("rework_count")
  openedAt       DateTime  @default(now()) @map("opened_at") @db.Timestamptz
  openedByUserId String?   @map("opened_by_user_id") @db.Uuid
  closedAt       DateTime? @map("closed_at") @db.Timestamptz
  closedByUserId String?   @map("closed_by_user_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([serviceOrderId])
  @@map("service_order_reworks")
}

model ServiceOrderItem {
