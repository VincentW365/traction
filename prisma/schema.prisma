// Bert's Service Operations Platform — Prisma Schema
// Translated from db/schema_outline.sql + maintenance intelligence delta + override lifecycle delta
// All 32 tables + 14 enums

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================
// ENUMS
// =========================

enum AppointmentStatus {
  DRAFT
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  MISSED
  CANCELLED
  RESCHEDULED
}

enum ServiceVisitStatus {
  CREATED
  ARRIVED
  CHECKED_IN
  QUEUED
  CALLED
  IN_SERVICE
  WAITING_PARTS
  QC
  READY_FOR_PICKUP
  CLOSED
  ABANDONED
  CANCELLED
}

enum QueueDisplayStatus {
  PENDING_RANK
  ISSUED
  WAITING
  CALLED
  IN_SERVICE
  BLOCKED
  COMPLETED
  CANCELLED
}

enum VisitSourceType {
  APPOINTMENT
  WALKIN
  HISTORICAL_IMPORT
}

enum QueuePriorityClass {
  APPT_PROTECTED
  APPT_LATE_SOFT
  WALKIN_STANDARD
  WALKIN_FASTTRACK
  BLOCKED_PARTS
  BLOCKED_SKILL
