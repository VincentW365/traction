  category          String // = source workbook tab (SERVICE, BRAKES, SUSPENSION, ...)
  subcategory       String?
  basePrice         Decimal?  @map("base_price") @db.Decimal(12, 2) // col F: current pre-tax estimate
  priceTaxInclusive Decimal?  @map("price_tax_inclusive") @db.Decimal(12, 2) // col G: incl. GCT
  laborPrice        Decimal?  @map("labor_price") @db.Decimal(12, 2) // null — file has no split
  partsPrice        Decimal?  @map("parts_price") @db.Decimal(12, 2) // null — file has no split
  currency          String?   @default("JMD")
  effectiveFrom     DateTime? @map("effective_from") @db.Timestamptz
  effectiveTo       DateTime? @map("effective_to") @db.Timestamptz
  active            Boolean   @default(true)
  source            String // e.g. PRICE_LIST_2026 (+ filename)
  rawImportRow      Json      @map("raw_import_row") // full included-row provenance (C..H + comment)
  rowHash           String    @map("row_hash") // dedup/idempotency for EXACT full-row repeats only
  serviceTypeId     String?   @map("service_type_id") @db.Uuid // soft reference (no DB FK in P1a)
  importBatchId     String?   @map("import_batch_id")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([rowHash])
  @@index([normalizedName])
  @@index([category])
  @@index([jobCode])
  @@index([serviceTypeId])
  @@map("service_catalog_items")
}

// CR-2026-019 (P1b) — job -> catalog mapping. Additive only; soft references
// (no DB FK) so existing tables are untouched. One row per matched segment;
// many per order. Source notes are NEVER modified — rawText is a copy.
enum ServiceMatchMethod {
  EXACT
  NORMALIZED
  FUZZY
  MANUAL
  NONE
}

enum ServiceMatchStatus {
  AUTO_MATCHED
  NEEDS_REVIEW
  CONFIRMED
  REJECTED
  UNMAPPED
}

model ServiceJobMapping {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceOrderId     String             @map("service_order_id") @db.Uuid // soft ref
  serviceOrderItemId String?            @map("service_order_item_id") @db.Uuid // soft ref (live)
  catalogItemId      String?            @map("catalog_item_id") @db.Uuid // soft ref; null = unmapped
  rawText            String?            @map("raw_text") // COPY of the matched segment; notes untouched
  confidence         Float?
  matchMethod        ServiceMatchMethod @map("match_method")
  status             ServiceMatchStatus
  segmentHash        String             @map("segment_hash") // idempotency: (orderId|itemId + normalized segment)
  reviewedByUserId   String?            @map("reviewed_by_user_id") @db.Uuid
  reviewedAt         DateTime?          @map("reviewed_at") @db.Timestamptz
  importBatchId      String?            @map("import_batch_id")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([segmentHash])
  @@index([serviceOrderId])
  @@index([catalogItemId])
  @@index([status])
  @@map("service_job_mappings")
}

// =========================
// CR-2026-020 — TEST DATA SANDBOX
// Run registry for disposable local/staging test data. The three operational
// anchors (Customer, Vehicle, ServiceVisit) carry a nullable testDataRunId for
// cheap reporting exclusion; every created row is additionally tagged via an
// ExternalSystemRef(system=TEST_DATA_RUN) manifest. The run row is KEPT after
// cleanup (status=CLEANED_UP) for audit — never deleted by the runner, so the
// Restrict FK never blocks. createdByUserId is a soft reference (no DB FK).
// =========================

enum TestDataRunStatus {
  ACTIVE
  CLEANED_UP
}

// CR-2026-023 — discriminates batch test runs (scripts/test-data.ts) from
// ephemeral dev-login sandbox sessions. Existing rows default to BATCH.
enum TestDataRunType {
  BATCH
  DEV_LOGIN_SESSION
}

model TestDataRun {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label           String            @unique // e.g. vw-test-run-2026-06-11
  createdByUserId String            @map("created_by_user_id") @db.Uuid // soft ref (no FK)
  notes           String?
  status          TestDataRunStatus @default(ACTIVE)
  runType         TestDataRunType   @default(BATCH) @map("run_type") // CR-2026-023
  expiresAt       DateTime?         @map("expires_at") @db.Timestamptz // CR-2026-023 (optional)
  cleanedAt       DateTime?         @map("cleaned_at") @db.Timestamptz
  creationSummary Json?             @map("creation_summary") // per-scenario created counts
  cleanupSummary  Json?             @map("cleanup_summary") // per-table delete counts + backup path
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  customers     Customer[]
  vehicles      Vehicle[]
  serviceVisits ServiceVisit[]

  @@index([status])
  @@index([runType])
  @@map("test_data_runs")
}

