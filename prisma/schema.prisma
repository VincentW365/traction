/// CR-2026-087 — pre-inspection vehicle photos, taken by the assigned technician
/// on their tablet.
///
/// Stored as a base64 data URL in a TEXT column, following the existing
/// InspectionSignature.imageData precedent. That is a deliberate trade: there is no
/// object store in this deployment and Render's free plan has NO persistent disk, so
/// anything written to the container filesystem is lost on every redeploy and cold
/// start. Keeping the bytes in Postgres is the only option that survives without
/// adding a third-party dependency.
///
/// The cost is database and backup size, so the client downscales before upload
/// (longest edge 1280px, JPEG) — a raw tablet photo is 1-5 MB and would both bloat
/// every row read and exceed the request body limit. Revisit an object store before
/// this becomes the shop's primary photographic record.
model InspectionPhoto {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inspectionId  String   @map("inspection_id") @db.Uuid
  /// base64 data URL, e.g. "data:image/jpeg;base64,..."
  imageData     String   @map("image_data")
  /// Optional free-text note, e.g. "front bumper scuff on arrival".
  caption       String?
  takenByUserId String?  @map("taken_by_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  inspection VehicleInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@map("inspection_photos")
}

model Technician {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
