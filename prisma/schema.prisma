// =========================
// MAINTENANCE INTELLIGENCE
// =========================

model VehicleSpecSnapshot {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicleId         String                   @map("vehicle_id") @db.Uuid
  vin               String?
  year              Int?
  make              String?
  model             String?
  trim              String?
  engineCode        String?                  @map("engine_code")
  engineDescription String?                  @map("engine_description")
  displacement      String?
  fuelType          String?                  @map("fuel_type")
  driveType         String?                  @map("drive_type")
  decodeSource      String                   @map("decode_source")
  decodeConfidence  RecommendationConfidence @map("decode_confidence")
  decodedAt         DateTime                 @map("decoded_at") @db.Timestamptz
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz

  vehicle                    Vehicle                     @relation(fields: [vehicleId], references: [id])
  maintenanceRecommendations MaintenanceRecommendation[] @relation("RecVehicleSpec")

  @@index([vehicleId])
  @@map("vehicle_spec_snapshots")
}

model FluidSpecSnapshot {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicleId              String                   @map("vehicle_id") @db.Uuid
  serviceTypeCode        String                   @map("service_type_code")
  saeViscosityGrade      String?                  @map("sae_viscosity_grade")
  apiCategory            String?                  @map("api_category")
  ilsacCategory          String?                  @map("ilsac_category")
  oemApprovalCode        String?                  @map("oem_approval_code")
  capacityWithFilter     Decimal?                 @map("capacity_with_filter") @db.Decimal(6, 2)
  capacityWithoutFilter  Decimal?                 @map("capacity_without_filter") @db.Decimal(6, 2)
  normalIntervalMiles    Int?                     @map("normal_interval_miles")
  severeIntervalMiles    Int?                     @map("severe_interval_miles")
  normalIntervalMonths   Int?                     @map("normal_interval_months")
  severeIntervalMonths   Int?                     @map("severe_interval_months")
  sourceProvider         String                   @map("source_provider")
  sourceReference        String?                  @map("source_reference")
  effectiveAt            DateTime?                @map("effective_at") @db.Timestamptz
  confidence             RecommendationConfidence
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz

  vehicle                    Vehicle                     @relation(fields: [vehicleId], references: [id])
  maintenanceRecommendations MaintenanceRecommendation[] @relation("RecFluidSpec")

  @@index([vehicleId, serviceTypeCode])
  @@map("fluid_spec_snapshots")
}

model MaintenanceRecommendation {
  id                         String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicleId                  String                   @map("vehicle_id") @db.Uuid
  serviceVisitId             String?                  @map("service_visit_id") @db.Uuid
  serviceOrderId             String?                  @map("service_order_id") @db.Uuid
  serviceTypeCode            String                   @map("service_type_code")
  recommendationType         String                   @map("recommendation_type") // POST_SERVICE | ADVISORY
  drivingProfile             DrivingProfile           @map("driving_profile")
  basisOdometer              Int?                     @map("basis_odometer")
  basisDate                  DateTime?                @map("basis_date") @db.Timestamptz
  intervalMiles              Int?                     @map("interval_miles")
  intervalMonths             Int?                     @map("interval_months")
  nextDueOdometer            Int?                     @map("next_due_odometer")
  nextDueDate                DateTime?                @map("next_due_date") @db.Timestamptz
  dueNowFlag                 Boolean?                 @map("due_now_flag")
  isDeterminable             Boolean                  @default(true) @map("is_determinable")
  recommendationSource       String                   @map("recommendation_source")
  confidence                 RecommendationConfidence
  fluidSpecSnapshotId        String?                  @map("fluid_spec_snapshot_id") @db.Uuid
  vehicleSpecSnapshotId      String?                  @map("vehicle_spec_snapshot_id") @db.Uuid
  supersedesRecommendationId String?                  @map("supersedes_recommendation_id") @db.Uuid
  notes                      String?
  createdByUserId            String?                  @map("created_by_user_id") @db.Uuid
  createdAt                  DateTime                 @default(now()) @map("created_at") @db.Timestamptz

  vehicle                    Vehicle                @relation(fields: [vehicleId], references: [id])
  serviceVisit               ServiceVisit?          @relation(fields: [serviceVisitId], references: [id])
  serviceOrder               ServiceOrder?          @relation(fields: [serviceOrderId], references: [id])
  fluidSpec                  FluidSpecSnapshot?     @relation("RecFluidSpec", fields: [fluidSpecSnapshotId], references: [id])
  vehicleSpec                VehicleSpecSnapshot?   @relation("RecVehicleSpec", fields: [vehicleSpecSnapshotId], references: [id])
  supersedesRecommendation   MaintenanceRecommendation?  @relation("RecommendationLineage", fields: [supersedesRecommendationId], references: [id])
  supersededBy               MaintenanceRecommendation[] @relation("RecommendationLineage")
  createdBy                  UserAccount?           @relation("MaintenanceRecCreatedBy", fields: [createdByUserId], references: [id])
  reminders                  MaintenanceReminder[]

  @@index([vehicleId])
  @@index([serviceVisitId])
  @@index([nextDueOdometer])
  @@index([nextDueDate])
  @@map("maintenance_recommendations")
}

// =========================
// v4.1 — WORK RESOURCES (alongside WorkBay, migration-safe)
// =========================

model WorkResource {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId              String              @map("site_id") @db.Uuid
  code                String
  name                String
  // --- Structured core fields (queried, filtered, used in dispatch logic) ---
  resourceCategory    ResourceCategory    @map("resource_category")
  maxVehicleWeight    VehicleWeightClass? @map("max_vehicle_weight")
  liftType            String?             @map("lift_type") // "heavy", "sedan", "mobile", "power_jack", null
  hasAlignment        Boolean             @default(false) @map("has_alignment")
  hasDiagnostics      Boolean             @default(false) @map("has_diagnostics")
  requiresMechanic    Boolean             @default(true) @map("requires_mechanic")
  showOnDispatchBoard Boolean             @default(true) @map("show_on_dispatch_board")
  isActive            Boolean             @default(true) @map("is_active")
  displayOrder        Int                 @default(0) @map("display_order")
  // --- JSON extensible flags (secondary, future-proofing) ---
  capabilities        Json?
  notes               String?
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  site         Site                  @relation(fields: [siteId], references: [id])
  occupancy         ResourceOccupancy?
  reservations      ResourceReservation[]
  assignments       TechnicianAssignment[]
  operationalStatus ResourceOperationalStatus?

  @@unique([siteId, code])
  @@map("work_resources")
}

model ResourceOperationalStatus {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resourceId    String   @unique @map("resource_id") @db.Uuid
  isOperational Boolean  @default(true) @map("is_operational")
  reason        String?
  setByUserId   String?  @map("set_by_user_id") @db.Uuid
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  resource WorkResource @relation(fields: [resourceId], references: [id])

  @@map("resource_operational_status")
}

model ResourceOccupancy {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resourceId     String    @unique @map("resource_id") @db.Uuid
  serviceVisitId String?   @map("service_visit_id") @db.Uuid
  serviceOrderId String?   @map("service_order_id") @db.Uuid
  technicianId   String?   @map("technician_id") @db.Uuid
  occupiedAt     DateTime  @default(now()) @map("occupied_at") @db.Timestamptz
  expectedEndAt  DateTime? @map("expected_end_at") @db.Timestamptz
  status         String    @default("AVAILABLE") // OCCUPIED, AVAILABLE

  resource     WorkResource   @relation(fields: [resourceId], references: [id])
  serviceVisit ServiceVisit?  @relation(fields: [serviceVisitId], references: [id])

  @@index([serviceVisitId])
  @@map("resource_occupancies")
}

model ResourceReservation {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId         String    @map("site_id") @db.Uuid
  resourceId     String?   @map("resource_id") @db.Uuid // null = "any compatible resource"
  appointmentId  String    @map("appointment_id") @db.Uuid
  serviceVisitId String?   @map("service_visit_id") @db.Uuid
  reservedFrom   DateTime  @map("reserved_from") @db.Timestamptz
  reservedUntil  DateTime  @map("reserved_until") @db.Timestamptz
  status         String    @default("PENDING") // PENDING, ACTIVE, CLAIMED, EXPIRED, CANCELLED
  claimedAt      DateTime? @map("claimed_at") @db.Timestamptz
  expiredAt      DateTime? @map("expired_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  site        Site          @relation(fields: [siteId], references: [id])
  resource    WorkResource? @relation(fields: [resourceId], references: [id])
  appointment Appointment   @relation(fields: [appointmentId], references: [id])

  @@index([siteId, status])
  @@index([appointmentId])
  @@map("resource_reservations")
}

// =========================
// v4.1 — EXTERNAL INTEGRATION REFERENCES
// =========================

model ExternalSystemRef {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  system        IntegrationSystem
  entityType    String            @map("entity_type") // "PartsRequest", "ServiceOrder", etc.
  entityId      String            @map("entity_id") @db.Uuid
  externalId    String            @map("external_id")
