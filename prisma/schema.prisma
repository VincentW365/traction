  status         String    @default("ASSIGNED")

  serviceOrder ServiceOrder  @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  technician   Technician    @relation(fields: [technicianId], references: [id])
  bay          WorkBay?      @relation(fields: [bayId], references: [id])
  resource     WorkResource? @relation(fields: [resourceId], references: [id])

  // CR-2026-090 — the actual periods this technician worked.
  workSegments TechnicianWorkSegment[]

  @@index([technicianId])
  @@index([serviceOrderId])
  @@map("technician_assignments")
}

