// =========================
// SERVICE CATALOG / PRICE LIST (CR-2026-019, P1a)
// Internal catalog/classification reference for analytics — NOT invoice truth,
// NOT a parts/labor pricing workflow. Prices are estimated/catalog values.
// Additive only. ServiceJobMapping (P1b) is intentionally NOT added here.
// =========================

model ServiceCatalogItem {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobCode           String?   @map("job_code") // null — the source price list has no SKU/code
  name              String
