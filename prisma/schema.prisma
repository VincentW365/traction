// =========================
// v4.1 — MAINTENANCE REMINDERS
// =========================

model MaintenanceReminder {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicleId           String             @map("vehicle_id") @db.Uuid
  customerId          String             @map("customer_id") @db.Uuid
  recommendationId    String?            @map("recommendation_id") @db.Uuid
  reminderType        String             @map("reminder_type") // TIME_BASED, MILEAGE_ESTIMATE, BOTH
  confidence          ReminderConfidence
  scheduledSendDate   DateTime?          @map("scheduled_send_date") @db.Date
  estimatedDueDate    DateTime?          @map("estimated_due_date") @db.Date
  estimatedDueMileage Int?               @map("estimated_due_mileage")
  status              ReminderStatus     @default(SCHEDULED)
  notificationLogId   String?            @map("notification_log_id") @db.Uuid
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz

  vehicle        Vehicle                    @relation(fields: [vehicleId], references: [id])
  customer       Customer                   @relation(fields: [customerId], references: [id])
  recommendation MaintenanceRecommendation? @relation(fields: [recommendationId], references: [id])

