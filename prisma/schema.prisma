  status        String   @default("ACTIVE")
  // CR-2026-087 — senior technicians are the ones who may be assigned a quality
  // check. Before this there was no seniority attribute at all: "senior tech
  // sign-off" on an inspection was RBAC standing in for it, which meant only a
  // manager could sign and an actual senior technician could not.
  isSenior      Boolean  @default(false) @map("is_senior")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  userAccount  UserAccount               @relation(fields: [userAccountId], references: [id])
