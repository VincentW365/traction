  vehicle    Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  reviewedBy UserAccount? @relation("ClassificationReviewedBy", fields: [reviewedByUserId], references: [id])

  @@index([status])
  @@map("vehicle_classifications")
}

// ===========================================================================
// CR-2026-088 — Technician KPI framework
//
// Measures technician-controlled job time (Start Work -> first Submit to QC,
// minus approved exclusions) against a benchmark for the vehicle class and the
// package of work, producing TWO ratings that are stored side by side.
//
// Deliberately separate from the service-duration model: ServiceType durations
// still drive booking, scheduling and ETAs and are untouched by any of this. A
// KPI standard is a whole-job benchmark, not a sum of catalogue times.
// ===========================================================================

/// The three manager-approved benchmark packages, plus the catch-all. A job is
/// benchmarked only when its services map EXACTLY onto one of the three.
enum KpiPackageType {
  GENERAL_SERVICE_ONLY
  GENERAL_SERVICE_FRONT_BRAKES
  GENERAL_SERVICE_FRONT_BRAKES_SPARK_PLUGS
  CUSTOM_UNBENCHMARKED
}

/// Component a service represents for package detection. Configured against
/// service-type IDs by an administrator — never inferred from a service name,
/// which is editable and would silently break the benchmark.
enum KpiPackageComponent {
  GENERAL_SERVICE
  FRONT_BRAKES
  SPARK_PLUGS
}

enum KpiRatingBand {
  EXCELLENT
  MEETS_TARGET
  NEEDS_IMPROVEMENT
  BELOW_STANDARD
}

/// Controlled reasons a job was delayed. Only some are ever eligible for KPI
/// exclusion, and even those need supervisor approval. Ordinary work difficulty,
/// tool searching, poor preparation and rework are never excluded.
enum KpiDelayReason {
  WAITING_FOR_PARTS
  WAITING_CUSTOMER_AUTHORIZATION
  BAY_OR_EQUIPMENT_UNAVAILABLE
  MANAGER_OR_QC_HOLD
  SYSTEM_OUTAGE
  SAFETY_HOLD
  /// Only when heat genuinely makes the work unsafe or impractical AND the
  /// technician cannot get on with another part of the approved job. Routine
  /// cooling is absorbed by the benchmark and the 30-minute tolerance.
  EXCEPTIONAL_THERMAL_SAFETY_HOLD
  TECHNICIAN_REASSIGNMENT
  OTHER
}

enum KpiApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Why a job carries no formal adjusted rating.
enum KpiEligibilityStatus {
  ELIGIBLE
  MISSING_VEHICLE_CLASS
  NOT_BENCHMARKED
  MISSING_TIMESTAMPS
  NO_PRIMARY_TECHNICIAN
  CANCELLED_OR_VOID
  INVALID_TIMER_DATA
}

/// An effective-dated set of KPI standards, snapshotted onto each job so that
/// changing standards later cannot silently recalculate historical results.
model KpiPolicy {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name    String
  version Int    @unique

  effectiveFrom DateTime  @map("effective_from") @db.Timestamptz
  effectiveTo   DateTime? @map("effective_to") @db.Timestamptz
  isActive      Boolean   @default(true) @map("is_active")

  // Scope-adjusted tolerances, in whole minutes of variance from standard.
  meetsToleranceMinutes            Int @default(30) @map("meets_tolerance_minutes")
  needsImprovementToleranceMinutes Int @default(60) @map("needs_improvement_tolerance_minutes")

  // The manager's absolute completion bands, in whole minutes. Snapshotted too,
  // so a later retune does not rewrite history.
  absoluteExcellentMaxMinutes        Int @default(120) @map("absolute_excellent_max_minutes")
  absoluteMeetsTargetMaxMinutes      Int @default(150) @map("absolute_meets_target_max_minutes")
  absoluteNeedsImprovementMaxMinutes Int @default(180) @map("absolute_needs_improvement_max_minutes")

  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  benchmarks KpiBenchmark[]
  snapshots  WorkOrderKpiSnapshot[]

  @@index([isActive, effectiveFrom])
  @@map("kpi_policies")
}

/// One standard time per (vehicle class, package) under a policy.
model KpiBenchmark {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyId String @map("policy_id") @db.Uuid

  vehicleClass    VehicleServiceClass @map("vehicle_class")
  packageType     KpiPackageType      @map("package_type")
  standardMinutes Int                 @map("standard_minutes")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  policy KpiPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, vehicleClass, packageType])
  @@map("kpi_benchmarks")
}

/// Administrator-controlled mapping of a service type to a package component.
model KpiServiceComponent {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceTypeId String              @unique @map("service_type_id") @db.Uuid
  component     KpiPackageComponent

  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  serviceType ServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)

  @@map("kpi_service_components")
}

/// The frozen KPI result for one work order. Everything needed to reproduce the
/// number lives here, including the policy version it was rated under.
model WorkOrderKpiSnapshot {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceOrderId String @unique @map("service_order_id") @db.Uuid

  policyId      String @map("policy_id") @db.Uuid
  policyVersion Int    @map("policy_version")

  vehicleClass VehicleServiceClass? @map("vehicle_class")
  packageType  KpiPackageType       @map("package_type")

  /// Null for a custom job with no approved standard.
  standardMinutes Int? @map("standard_minutes")

  /// A manager-approved standard for an otherwise unbenchmarked job.
  customStandardMinutes    Int?      @map("custom_standard_minutes")
  customStandardReason     String?   @map("custom_standard_reason")
  customStandardByUserId   String?   @map("custom_standard_by_user_id") @db.Uuid
  customStandardApprovedAt DateTime? @map("custom_standard_approved_at") @db.Timestamptz

  firstWorkStartedAt   DateTime? @map("first_work_started_at") @db.Timestamptz
  firstSubmittedToQcAt DateTime? @map("first_submitted_to_qc_at") @db.Timestamptz

  rawElapsedMinutes       Int?   @map("raw_elapsed_minutes")
  approvedExcludedMinutes Int    @default(0) @map("approved_excluded_minutes")
  kpiCompletionMinutes    Int?   @map("kpi_completion_minutes")
  varianceMinutes         Int?   @map("variance_minutes")
  variancePercent         Float? @map("variance_percent")

  absoluteCompletionRating KpiRatingBand? @map("absolute_completion_rating")
  adjustedTechnicianRating KpiRatingBand? @map("adjusted_technician_rating")
  onTarget                 Boolean        @default(false) @map("on_target")

  eligibilityStatus KpiEligibilityStatus @default(ELIGIBLE) @map("eligibility_status")
  eligibilityReason String?              @map("eligibility_reason")

  primaryTechnicianId String? @map("primary_technician_id") @db.Uuid

  /// True when more than one technician worked it, or it was reassigned mid-job.
  /// Such jobs stay out of individual leaderboards but remain in detailed reporting.
  isSharedOrReassigned Boolean @default(false) @map("is_shared_or_reassigned")

  /// Set when QC sent the job back. The completion result above is preserved.
  hadRework Boolean @default(false) @map("had_rework")

  calculatedAt DateTime  @default(now()) @map("calculated_at") @db.Timestamptz
  finalisedAt  DateTime? @map("finalised_at") @db.Timestamptz

  // Post-completion correction — always visible, always reasoned.
  correctedByUserId String?   @map("corrected_by_user_id") @db.Uuid
  correctedAt       DateTime? @map("corrected_at") @db.Timestamptz
  correctionReason  String?   @map("correction_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  policy       KpiPolicy    @relation(fields: [policyId], references: [id], onDelete: Restrict)

  @@index([adjustedTechnicianRating])
  @@index([packageType])
  @@index([primaryTechnicianId])
  @@index([eligibilityStatus])
  @@map("work_order_kpi_snapshots")
}

/// A recorded delay and its journey through approval. A technician may record
/// one; a technician may never approve their own exclusion.
model KpiDelayEvent {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceOrderId String  @map("service_order_id") @db.Uuid
  technicianId   String? @map("technician_id") @db.Uuid

  reasonCode  KpiDelayReason @map("reason_code")
  description String?

  startedAt       DateTime  @map("started_at") @db.Timestamptz
  endedAt         DateTime? @map("ended_at") @db.Timestamptz
  durationMinutes Int?      @map("duration_minutes")

  requestedForExclusion Boolean           @default(false) @map("requested_for_exclusion")
  approvalStatus        KpiApprovalStatus @default(PENDING) @map("approval_status")
  approvedByUserId      String?           @map("approved_by_user_id") @db.Uuid
  approvedAt            DateTime?         @map("approved_at") @db.Timestamptz
  rejectionReason       String?           @map("rejection_reason")

  /// Links back to the existing recording-only pause ledger when the delay was
  /// raised from a pause, so the two can never diverge.
  serviceOrderPauseId String? @unique @map("service_order_pause_id") @db.Uuid

  recordedByUserId String?  @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([serviceOrderId])
  @@index([approvalStatus])
  @@map("kpi_delay_events")
}

// ===========================================================================
// CR-2026-089 — Queue ticket numbering v2
//
//   Full reference   B01-260820-003    {LOCATION}-{YYMMDD}-{SEQUENCE}
//   Customer number  B01-003           {LOCATION}-{SEQUENCE}
//   Display emphasis 003
//
// Replaces QTK-BERT-01-20260820-0003. "QTK" and "BERT" told nobody anything —
// the application already knows the record is a queue ticket and whose it is —
// and the four-digit year and extra padding cost width on a lobby screen and on
// a technician's phone for no identification benefit.
//
// Legacy tickets are NOT rewritten. They keep their original number for
// auditability, and every read path continues to work because nothing anywhere
// parses the string; it has always been an opaque display token.
// ===========================================================================

/// Atomic per-location, per-business-day sequence allocator.
///
/// The previous generator read MAX(sequence)+1 and relied entirely on the caller
/// running under SERIALIZABLE. That is technically safe but practically poor:
/// Prisma does not retry, so two front-desk staff checking in at the same moment
/// gave one of them a raw 500. A single-row upsert-and-increment is atomic on its
/// own, so concurrency is handled where it arises rather than by isolation level.
model DailyTicketCounter {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId String @map("site_id") @db.Uuid

  /// The Jamaica business date, not the server's UTC date. Stored as a plain DATE
  /// so the reset boundary is unambiguous.
  businessDate DateTime @map("business_date") @db.Date

  lastSequence Int      @default(0) @map("last_sequence")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, businessDate])
  @@map("daily_ticket_counters")
}
