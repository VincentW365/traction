// ===========================================================================
// CR-2026-088 — Technician KPI framework
//
// Measures technician-controlled job time (Start Work -> first Submit to QC,
// minus approved exclusions) against a benchmark for the vehicle class and the
// package of work, producing TWO ratings that are stored side by side.
//
// Deliberately separate from the service-duration model: ServiceType durations
// still drive booking, scheduling and ETAs and are untouched by any of this. A
// KPI standard is a whole-job benchmark, not a sum of catalogue times.
// ===========================================================================

/// The three manager-approved benchmark packages, plus the catch-all. A job is
/// benchmarked only when its services map EXACTLY onto one of the three.
enum KpiPackageType {
  GENERAL_SERVICE_ONLY
  GENERAL_SERVICE_FRONT_BRAKES
  GENERAL_SERVICE_FRONT_BRAKES_SPARK_PLUGS
  CUSTOM_UNBENCHMARKED
}

/// Component a service represents for package detection. Configured against
/// service-type IDs by an administrator — never inferred from a service name,
/// which is editable and would silently break the benchmark.
enum KpiPackageComponent {
  GENERAL_SERVICE
  FRONT_BRAKES
  SPARK_PLUGS
}

enum KpiRatingBand {
  EXCELLENT
  MEETS_TARGET
  NEEDS_IMPROVEMENT
  BELOW_STANDARD
}

/// Controlled reasons a job was delayed. Only some are ever eligible for KPI
/// exclusion, and even those need supervisor approval. Ordinary work difficulty,
/// tool searching, poor preparation and rework are never excluded.
enum KpiDelayReason {
  WAITING_FOR_PARTS
  WAITING_CUSTOMER_AUTHORIZATION
  BAY_OR_EQUIPMENT_UNAVAILABLE
  MANAGER_OR_QC_HOLD
  SYSTEM_OUTAGE
  SAFETY_HOLD
  /// Only when heat genuinely makes the work unsafe or impractical AND the
  /// technician cannot get on with another part of the approved job. Routine
  /// cooling is absorbed by the benchmark and the 30-minute tolerance.
  EXCEPTIONAL_THERMAL_SAFETY_HOLD
  TECHNICIAN_REASSIGNMENT
  OTHER
}

enum KpiApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Why a job carries no formal adjusted rating.
enum KpiEligibilityStatus {
  ELIGIBLE
  MISSING_VEHICLE_CLASS
  /// The work genuinely has no agreed standard — a deliberate answer, not a gap.
  NOT_BENCHMARKED
  /// CR-2026-091 — configuration is missing, so the job cannot be rated YET. Distinct
  /// from NOT_BENCHMARKED because it is an outstanding task rather than a conclusion,
  /// and because a job in this state carries NO rating of any kind: an admin gap must
  /// never read as a technician's poor result.
  PENDING_BENCHMARK_REVIEW
  MISSING_TIMESTAMPS
  NO_PRIMARY_TECHNICIAN
  CANCELLED_OR_VOID
  INVALID_TIMER_DATA
}

/// An effective-dated set of KPI standards, snapshotted onto each job so that
/// changing standards later cannot silently recalculate historical results.
model KpiPolicy {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name    String
  version Int    @unique

  effectiveFrom DateTime  @map("effective_from") @db.Timestamptz
  effectiveTo   DateTime? @map("effective_to") @db.Timestamptz
  isActive      Boolean   @default(true) @map("is_active")

  // Scope-adjusted tolerances, in whole minutes of variance from standard.
  meetsToleranceMinutes            Int @default(30) @map("meets_tolerance_minutes")
  needsImprovementToleranceMinutes Int @default(60) @map("needs_improvement_tolerance_minutes")

  // The manager's absolute completion bands, in whole minutes. Snapshotted too,
  // so a later retune does not rewrite history.
  absoluteExcellentMaxMinutes        Int @default(120) @map("absolute_excellent_max_minutes")
  absoluteMeetsTargetMaxMinutes      Int @default(150) @map("absolute_meets_target_max_minutes")
  absoluteNeedsImprovementMaxMinutes Int @default(180) @map("absolute_needs_improvement_max_minutes")

  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  benchmarks KpiBenchmark[]
  snapshots  WorkOrderKpiSnapshot[]

  @@index([isActive, effectiveFrom])
  @@map("kpi_policies")
}

/// One standard time per (vehicle class, package) under a policy.
model KpiBenchmark {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyId String @map("policy_id") @db.Uuid

  vehicleClass    VehicleServiceClass @map("vehicle_class")
  packageType     KpiPackageType      @map("package_type")
  standardMinutes Int                 @map("standard_minutes")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  policy KpiPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, vehicleClass, packageType])
  @@map("kpi_benchmarks")
}

/// Administrator-controlled mapping of a service type to a package component.
model KpiServiceComponent {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceTypeId String @map("service_type_id") @db.Uuid

  /// CR-2026-090 — the richer role. Several services may map to the SAME role as
  /// aliases (the catalogue carries more than one code for disc-pad work); package
  /// detection de-duplicates by role, so two aliases on one order never count the
  /// component twice.
  componentRole KpiComponentRole @map("component_role")

  /// When true, the service only satisfies its component if the order line carries
  /// an axle qualifier of FRONT (or FRONT_AND_REAR where management allows it).
  /// Rear-brake-only work must never silently satisfy Front Brakes.
  requiresAxleQualifier Boolean @default(false) @map("requires_axle_qualifier")

  // -------------------------------------------------------------------------
  // CR-2026-092 — service contribution policy
  //
  // Replaces the binary "identifies a package, or forces the job custom" model. Most
  // real work is neither: a fuel filter is genuine extra technician time that should
  // extend the standard, a tyre-pressure check is already inside the General Service
  // allowance, and preparing a quotation is not technician repair time at all.
  // Collapsing those three into "not benchmarked" is what made ordinary jobs
  // unrateable.
  // -------------------------------------------------------------------------

  /// How this service contributes to the job's standard.
  contributionMode KpiContributionMode @default(CUSTOM_ONLY) @map("contribution_mode")

  /// Where the minutes come from when the mode contributes time.
  durationSource KpiDurationSource @default(NO_DURATION) @map("duration_source")

  /// Independently configured minutes, used only with FIXED_CONFIGURED_DURATION.
  /// Null means "fall back to the duration source" rather than "zero minutes" —
  /// there is no such thing as an approved zero-minute repair.
  ///
  /// Sedan and SUV are held separately because the manager's PACKAGE base differs by
  /// class. Additive services deliberately start with one figure for both: inventing
  /// a class split nobody approved would rate an SUV technician against a number
  /// management never agreed.
  fixedSedanMinutes Int? @map("fixed_sedan_minutes")
  fixedSuvMinutes   Int? @map("fixed_suv_minutes")

  /// Whether the allowance applies once per job, once per booked line, or per unit.
  /// PER_JOB is the default and the safe one: a four-wheel rotation is one job, and
  /// multiplying its whole-job time by four would quadruple the standard for work
  /// that was always priced as a single operation.
  allowanceBasis KpiAllowanceBasis @default(PER_JOB) @map("allowance_basis")

  /// A structured qualifier the work-order line must carry before this service can be
  /// resolved. CONDITIONAL services are meaningless without one — "brake work" is
  /// front pads or rear shoes or a fluid bleed, and those are different jobs.
  requiredQualifier KpiRequiredQualifier @default(NONE) @map("required_qualifier")

  /// The configured duration is a stand-in seeded because the catalogue had none, not
  /// a figure management approved. Surfaced as a warning in the admin screen so it is
  /// replaced deliberately rather than hardening into an accepted standard by default.
  provisionalDuration Boolean @default(false) @map("provisional_duration")

  /// Superseded catalogue codes stay resolvable for historical work orders but should
  /// not be offered for new bookings.
  isSupersededCode Boolean @default(false) @map("is_superseded_code")

  /// Mappings are effective-dated and superseded, never deleted, because historical
  /// KPI snapshots were produced under them.
  isActive      Boolean   @default(true) @map("is_active")
  effectiveFrom DateTime  @default(now()) @map("effective_from") @db.Timestamptz
  effectiveTo   DateTime? @map("effective_to") @db.Timestamptz

  notes String?

  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  serviceType ServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)

  @@index([serviceTypeId, isActive])
  @@index([componentRole, isActive])
  @@map("kpi_service_components")
}

/// The frozen KPI result for one work order. Everything needed to reproduce the
/// number lives here, including the policy version it was rated under.
model WorkOrderKpiSnapshot {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceOrderId String @unique @map("service_order_id") @db.Uuid

  policyId      String @map("policy_id") @db.Uuid
  policyVersion Int    @map("policy_version")

  vehicleClass VehicleServiceClass? @map("vehicle_class")
  packageType  KpiPackageType       @map("package_type")

  /// Null for a custom job with no approved standard.
  standardMinutes Int? @map("standard_minutes")

  /// A manager-approved standard for an otherwise unbenchmarked job.
  customStandardMinutes    Int?      @map("custom_standard_minutes")
  customStandardReason     String?   @map("custom_standard_reason")
  customStandardByUserId   String?   @map("custom_standard_by_user_id") @db.Uuid
  customStandardApprovedAt DateTime? @map("custom_standard_approved_at") @db.Timestamptz

  firstWorkStartedAt   DateTime? @map("first_work_started_at") @db.Timestamptz
  firstSubmittedToQcAt DateTime? @map("first_submitted_to_qc_at") @db.Timestamptz

  rawElapsedMinutes       Int?   @map("raw_elapsed_minutes")
  approvedExcludedMinutes Int    @default(0) @map("approved_excluded_minutes")
  kpiCompletionMinutes    Int?   @map("kpi_completion_minutes")
  varianceMinutes         Int?   @map("variance_minutes")
  variancePercent         Float? @map("variance_percent")

  absoluteCompletionRating KpiRatingBand? @map("absolute_completion_rating")
  adjustedTechnicianRating KpiRatingBand? @map("adjusted_technician_rating")
  onTarget                 Boolean        @default(false) @map("on_target")

  eligibilityStatus KpiEligibilityStatus @default(ELIGIBLE) @map("eligibility_status")
  eligibilityReason String?              @map("eligibility_reason")

  /// CR-2026-091 — the job could not be benchmarked because CONFIGURATION is missing
  /// (a service nobody has mapped, or a brake line with no axle recorded), not because
  /// the work genuinely has no agreed standard.
  ///
  /// Kept as its own fact rather than inferred from the reason text, because the two
  /// cases need opposite handling: a deliberate custom job is a finished answer, while
  /// this is an outstanding task. Recorded when the snapshot opens and refreshed on
  /// scope changes, so the classification reflects the mapping in force at the time
  /// rather than whatever the mapping happens to say when a report is run.
  pendingBenchmarkReview Boolean @default(false) @map("pending_benchmark_review")

  /// Set when a manager re-rated the job after supplying the missing configuration.
  /// Always audited — this is the one path that gives a finished job its first rating.
  benchmarkResolvedAt       DateTime? @map("benchmark_resolved_at") @db.Timestamptz
  benchmarkResolvedByUserId String?   @map("benchmark_resolved_by_user_id") @db.Uuid

  /// CR-2026-092 — how the final standard was built.
  ///
  /// Without this, "standard 120 minutes" is unreadable: it could be a Sedan General
  /// Service package, or a standalone brake repair whose catalogue times happen to
  /// sum to the same figure. Management must never assume a standalone repair was
  /// measured against a package.
  benchmarkSource KpiBenchmarkSource @default(NOT_TECHNICIAN_RATED) @map("benchmark_source")

  /// The full arithmetic behind `standardMinutes`: base package, each additive and
  /// its minutes, included services contributing zero, separate-SLA activity excluded
  /// from technician time, and the total.
  ///
  /// Stored rather than recomputed because the mapping it was built from is
  /// effective-dated and will change. A standard nobody can reconstruct is a standard
  /// nobody can defend in a review with the technician it rated.
  calculationBreakdown Json? @map("calculation_breakdown")

  /// Prior calculations, newest last, each with actor, reason and timestamp. A scope
  /// change before completion revises the standard; the superseded arithmetic is kept
  /// so the change is visible rather than silent.
  calculationRevisions Json? @map("calculation_revisions")

  primaryTechnicianId String? @map("primary_technician_id") @db.Uuid

  /// True when more than one technician worked it, or it was reassigned mid-job.
  /// Such jobs stay out of individual leaderboards but remain in detailed reporting.
  isSharedOrReassigned Boolean @default(false) @map("is_shared_or_reassigned")

  /// Set when QC sent the job back. The completion result above is preserved.
  hadRework Boolean @default(false) @map("had_rework")

  calculatedAt DateTime  @default(now()) @map("calculated_at") @db.Timestamptz
  finalisedAt  DateTime? @map("finalised_at") @db.Timestamptz

  // Post-completion correction — always visible, always reasoned.
  correctedByUserId String?   @map("corrected_by_user_id") @db.Uuid
  correctedAt       DateTime? @map("corrected_at") @db.Timestamptz
  correctionReason  String?   @map("correction_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  policy       KpiPolicy    @relation(fields: [policyId], references: [id], onDelete: Restrict)

  @@index([adjustedTechnicianRating])
  @@index([packageType])
  @@index([primaryTechnicianId])
  @@index([eligibilityStatus])
  @@map("work_order_kpi_snapshots")
}

/// A recorded delay and its journey through approval. A technician may record
/// one; a technician may never approve their own exclusion.
model KpiDelayEvent {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceOrderId String  @map("service_order_id") @db.Uuid
  technicianId   String? @map("technician_id") @db.Uuid

  reasonCode  KpiDelayReason @map("reason_code")
  description String?

  startedAt       DateTime  @map("started_at") @db.Timestamptz
  endedAt         DateTime? @map("ended_at") @db.Timestamptz
  durationMinutes Int?      @map("duration_minutes")

  requestedForExclusion Boolean           @default(false) @map("requested_for_exclusion")
  approvalStatus        KpiApprovalStatus @default(PENDING) @map("approval_status")
  approvedByUserId      String?           @map("approved_by_user_id") @db.Uuid
  approvedAt            DateTime?         @map("approved_at") @db.Timestamptz
  rejectionReason       String?           @map("rejection_reason")

  /// Links back to the existing recording-only pause ledger when the delay was
  /// raised from a pause, so the two can never diverge.
  serviceOrderPauseId String? @unique @map("service_order_pause_id") @db.Uuid

  recordedByUserId String?  @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([serviceOrderId])
  @@index([approvalStatus])
  @@map("kpi_delay_events")
}

// ===========================================================================
// CR-2026-089 — Queue ticket numbering v2
//
//   Full reference   B01-260820-003    {LOCATION}-{YYMMDD}-{SEQUENCE}
//   Customer number  B01-003           {LOCATION}-{SEQUENCE}
//   Display emphasis 003
//
// Replaces QTK-BERT-01-20260820-0003. "QTK" and "BERT" told nobody anything —
// the application already knows the record is a queue ticket and whose it is —
// and the four-digit year and extra padding cost width on a lobby screen and on
// a technician's phone for no identification benefit.
//
// Legacy tickets are NOT rewritten. They keep their original number for
// auditability, and every read path continues to work because nothing anywhere
// parses the string; it has always been an opaque display token.
// ===========================================================================

/// Atomic per-location, per-business-day sequence allocator.
///
/// The previous generator read MAX(sequence)+1 and relied entirely on the caller
/// running under SERIALIZABLE. That is technically safe but practically poor:
/// Prisma does not retry, so two front-desk staff checking in at the same moment
/// gave one of them a raw 500. A single-row upsert-and-increment is atomic on its
/// own, so concurrency is handled where it arises rather than by isolation level.
model DailyTicketCounter {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId String @map("site_id") @db.Uuid

  /// The Jamaica business date, not the server's UTC date. Stored as a plain DATE
  /// so the reset boundary is unambiguous.
  businessDate DateTime @map("business_date") @db.Date

  lastSequence Int      @default(0) @map("last_sequence")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, businessDate])
  @@map("daily_ticket_counters")
}

// ===========================================================================
// CR-2026-090 — KPI mapping v2: component roles, service aliases, axle qualifier
// ===========================================================================

/// Which axle a service line applies to.
///
/// Added because the shop's real price list distinguishes axles explicitly — it
/// carries separate lines for "To R/R DISC PADS" and "To R/R DISC PADS rear
/// electronic", plus brake shoes (drums, typically rear). Traction's own service
/// codes carry no axle, so a brake line is ambiguous on its own and must not be
/// allowed to satisfy the Front Brakes benchmark by default.
enum AxlePosition {
  FRONT
  REAR
  FRONT_AND_REAR
  NOT_APPLICABLE
}

/// What a mapped service means for benchmarking.
///
/// Richer than a plain "this service IS front brakes", because the interesting
/// cases are the other three: work already covered by the General Service
/// standard, and work substantial enough that the manager's packages stop
/// describing the job at all.
enum KpiComponentRole {
  /// Defines the General Service component of a benchmark package.
  GENERAL_SERVICE_CORE
  /// Defines the Front Brakes component (subject to the axle qualifier).
  FRONT_BRAKES
  /// Defines the Spark Plugs component.
  SPARK_PLUGS
  /// Minor work already absorbed by the General Service standard — present on the
  /// order, but adds no component and no extra time.
  INCLUDED_NO_ADDITIONAL_BENCHMARK
  /// Substantial additional work the approved packages do not describe. Its
  /// presence forces CUSTOM_UNBENCHMARKED unless a manager approves a standard,
  /// so a gearbox strip bolted onto an oil change is never quietly measured
  /// against the 90-minute General Service benchmark.
  FORCES_CUSTOM_BENCHMARK
}

// ===========================================================================
// CR-2026-092 — service contribution policy
// ===========================================================================

/// How a service contributes to a job's KPI standard.
///
/// The old model had two answers: the service identifies a manager package, or it
/// makes the job custom. Most real work is neither, and forcing it into one of those
/// two is what left ordinary jobs unrateable.
enum KpiContributionMode {
  /// Helps identify one of the three manager-approved packages.
  PACKAGE_COMPONENT
  /// Already absorbed by the applicable package. Adds no minutes, and — critically —
  /// does not knock the job out of its package for being booked as its own line.
  INCLUDED_IN_BASE
  /// Genuine additional technician work. Its approved duration is ADDED to the
  /// package standard rather than replacing it or voiding it.
  ADDITIVE_STANDARD
  /// Tracked operationally but outside technician repair time — quotation
  /// preparation, advisor processing. It neither extends the standard nor makes the
  /// job unrateable; the technician is neither charged nor credited for it.
  SEPARATE_SLA
  /// Contribution depends on a structured qualifier (which axle, which tyre
  /// operation). Resolves to one of the modes above once the qualifier is supplied,
  /// and must never stay unresolved after it is.
  CONDITIONAL
  /// Genuinely bespoke or highly variable work no catalogue standard can describe.
  /// Deliberately narrow: NOT for "this simply is not one of the three packages".
  CUSTOM_ONLY
}

/// Where a contribution's minutes come from.
enum KpiDurationSource {
  /// The manager's Sedan/SUV package matrix.
  MANAGER_PACKAGE
  /// The service's own catalogue duration — the immediate source for additive work,
  /// so a shop that already maintains its durations does not restate them here.
  SERVICE_CATALOG_DURATION
  /// A figure configured on the mapping, independent of the catalogue.
  FIXED_CONFIGURED_DURATION
  /// Contributes no minutes at all (included work, separate-SLA activity).
  NO_DURATION
}

/// How often a contribution's allowance applies.
enum KpiAllowanceBasis {
  /// Once for the whole job. The default, and the safe one.
  PER_JOB
  /// Once per booked service line.
  PER_SERVICE_LINE
  /// Per physical unit, and ONLY where the catalogue explicitly prices it that way.
  /// Multiplying a whole-job rotation time by four wheels would quadruple a standard
  /// for work that was always one operation.
  PER_UNIT
}

/// What kind of structured qualifier a CONDITIONAL service needs before it resolves.
enum KpiRequiredQualifier {
  NONE
  /// Axle plus brake work type — front pads and rear shoes are different jobs.
  BRAKE
  /// Which tyre operation — a pressure check and a replacement are different jobs.
  TIRE_OPERATION
}

/// Which axle a brake contribution applies to, once resolved.
///
/// Separate from `AxlePosition` on purpose: a line may be booked FRONT_AND_REAR, but
/// the benchmark resolves it into two distinct contributions, and each of those is
/// unambiguously one axle.
enum BrakeAxle {
  FRONT
  REAR
}

/// What brake work a line actually represents.
enum BrakeWorkType {
  PADS
  SHOES
  ROTOR_OR_DISC
  FLUID_OR_BLEED
  INSPECTION_ONLY
  OTHER
}

/// What tyre work a line actually represents.
enum TireOperation {
  PRESSURE_OR_TREAD_CHECK
  ROTATION
  BALANCE
  ALIGNMENT
  PUNCTURE_REPAIR
  REPLACEMENT
  OTHER_PHYSICAL_WORK
}

/// Where a job's final standard came from.
///
/// Stored on every snapshot so management can never assume a standalone brake repair
/// was measured against the General Service package. "120 minutes" means different
/// things depending on how it was built, and the report has to say which.
enum KpiBenchmarkSource {
  /// The manager's package matrix alone.
  MANAGER_PACKAGE
  /// The package plus approved additive services.
  MANAGER_PACKAGE_PLUS_ADDITIVES
  /// No General Service present — built from catalogue durations.
  CATALOG_COMPOSITE
  /// A manager-approved custom standard for this job.
  MANAGER_CUSTOM
  /// Not technician repair work, or nothing rateable on the order.
  NOT_TECHNICIAN_RATED
}

/// Per-technician work segment — the actual periods a named technician was working
/// on a job.
///
/// Exists because technician labour and job elapsed time are different quantities
/// and the pause ledger cannot separate them: pauses are recorded per ORDER, so
/// when two technicians overlap there is no way to say who was working when. This
/// model records that directly rather than inferring it.
///
/// Deliberately hangs off the existing TechnicianAssignment rather than creating a
/// competing technician or work-order entity.
model TechnicianWorkSegment {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceOrderId String @map("service_order_id") @db.Uuid
  assignmentId   String @map("assignment_id") @db.Uuid
  technicianId   String @map("technician_id") @db.Uuid

  /// The technician's role AS AT the segment. Snapshotted because a technician can
  /// be promoted from assisting to primary mid-job, and the earlier segments must
  /// keep saying what they were at the time.
  roleSnapshot TechnicianSegmentRole @default(PRIMARY) @map("role_snapshot")

  startedAt DateTime  @map("started_at") @db.Timestamptz
  endedAt   DateTime? @map("ended_at") @db.Timestamptz

  startedByUserId String? @map("started_by_user_id") @db.Uuid
  endedByUserId   String? @map("ended_by_user_id") @db.Uuid

  startSource SegmentStartSource @default(TECHNICIAN_START) @map("start_source")
  endReason   SegmentEndReason?  @map("end_reason")

  notes String?

  /// Set when a manager corrected the segment after the fact. Always reasoned and
  /// audited — a silently editable labour record is not a labour record.
  correctedByUserId String?   @map("corrected_by_user_id") @db.Uuid
  correctedAt       DateTime? @map("corrected_at") @db.Timestamptz
  correctionReason  String?   @map("correction_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  serviceOrder ServiceOrder         @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  assignment   TechnicianAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([serviceOrderId])
  @@index([technicianId])
  @@index([assignmentId])
  @@map("technician_work_segments")
}

enum TechnicianSegmentRole {
  PRIMARY
  ASSISTING
  REPLACEMENT
}

enum SegmentStartSource {
  TECHNICIAN_START
  TECHNICIAN_RESUME
  ASSISTANCE_START
  REASSIGNMENT
  MANAGER_CORRECTION
}

enum SegmentEndReason {
  PAUSED
  REASSIGNED
  ASSISTANCE_COMPLETE
  SUBMITTED_TO_QC
  JOB_CANCELLED
  /// Closed by the system because the technician never closed it themselves —
  /// flagged so a manager can tell a real record from a tidy-up.
  SYSTEM_CLOSED
  CORRECTED_BY_MANAGER
  /// CR-2026-100 — the technician moved to another job while others kept working
  /// this one: only their segment closes, the order stays IN_PROGRESS.
  SWITCHED_JOB
}
