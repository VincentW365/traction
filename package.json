{
  "name": "bsop",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "deploy": "pnpm install --frozen-lockfile && pnpm exec prisma generate && pnpm run db:migrate && pnpm run build && pnpm run db:seed",
    "db:reset": "node scripts/guard-not-production.mjs && prisma migrate reset",
    "db:studio": "prisma studio",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "verify:kpi": "node scripts/verify-kpi-contributions.mjs",
    "capture:kpi": "node scripts/capture-kpi-screenshots.mjs",
    "deploy:check": "node scripts/deploy-check.mjs",
    "deploy:bootstrap": "node scripts/deploy-bootstrap.mjs",
    "customers:import": "tsx apps/api/scripts/import-customers.ts",
    "customers:import:commit": "tsx apps/api/scripts/import-customers.ts --commit",
  "customers:reconcile": "tsx apps/api/scripts/import-customers.ts --reconcile",
  "customers:reconcile:master": "tsx apps/api/scripts/reconcile-master-list.ts",
    "customers:verify": "node scripts/customers-verify.mjs",
    "jobs:import": "tsx apps/api/scripts/import-jobs.ts",
    "jobs:import:commit": "tsx apps/api/scripts/import-jobs.ts --commit"
  },
  "devDependencies": {
    "playwright": "^1.59.0",
    "prettier": "^3",
    "prisma": "^6",
    "tsx": "^4",
    "turbo": "^2"
  },
  "dependencies": {
    "@prisma/client": "^6"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "esbuild",
      "prisma",
      "sharp",
      "msgpackr-extract"
    ]
  }
}
