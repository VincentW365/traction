# ============================================================
# BSOP Environment Configuration
# Copy to .env and fill in values
# ============================================================

# --- Database ---
DATABASE_URL="postgresql://bsop:bsop_dev@localhost:5432/bsop_dev?schema=public"

# --- Redis ---
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# --- Auth ---
JWT_SECRET="change-me-in-production-minimum-32-characters-long"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
# Developer one-click login + sandbox sessions. MUST be "false" in production — it
# bypasses the password form and grants full access. Local/staging testing only.
ALLOW_DEV_LOGIN="false"

# --- API ---
API_PORT="3001"
API_CORS_ORIGIN="http://localhost:3000"

# --- Frontend ---
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
NEXT_PUBLIC_WS_URL="http://localhost:3001"

# --- Notifications (stub in Phase 1) ---
NOTIFICATION_PROVIDER="stub"
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""
# TWILIO_MESSAGING_SERVICE_SID=""   # alternative to TWILIO_FROM_NUMBER; set NOTIFICATION_PROVIDER="twilio" to enable SMS
# SENDGRID_API_KEY=""
# SENDGRID_FROM_EMAIL=""

# --- Vehicle identity (VIN decode) ---
# STUB (default) = no outbound calls — safe for local/dev, data import, offline use.
# Live NHTSA vPIC (https://vpic.nhtsa.dot.gov) is OPT-IN: set VIN_DECODE_PROVIDER="LIVE".
# Any value other than "LIVE" (incl. unset) stays STUB.
VIN_DECODE_PROVIDER="STUB"

# --- Observability ---
LOG_LEVEL="debug"
LOG_FORMAT="json"

# --- Site ---
DEFAULT_SITE_CODE="BERT-01"
