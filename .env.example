# ============================================================================
# BSOP environment contract (CR-2026-094)
#
# This file is the COMPLETE list of environment variables the application reads.
# Copy to .env for local development. In deployment, set variables in the host's
# environment (Render dashboard / blueprint) — never in a committed file.
#
# Legend on every variable:
#   [REQUIRED]      the application refuses to start without it (validated at boot)
#   [PROD]          required in production, defaulted or optional in development
#   [OPTIONAL]      safe default applies when unset
#   [DEV-ONLY]      ignored or refused when NODE_ENV=production
#
# No real values belong in this file. Ever.
# ============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# [OPTIONAL] development | test | production. Render sets this to production.
NODE_ENV="development"
# [OPTIONAL] API listen port (default 3001). Platform-injected PORT (e.g. Render)
# takes precedence over API_PORT when both are set.
API_PORT="3001"
# [PROD] Comma-separated allowed web origins. In production this MUST be the
# deployed web URL or browsers will refuse every API call.
API_CORS_ORIGIN="http://localhost:3000"
# [PROD] CR-2026-106 — the ONE browser-reachable base URL of the web app, used for
# every customer-facing link (status page, booking manage link, booking link).
# Must be https and a public host in production (deploy:check fails otherwise).
# Leave unset locally to fall back to the first CORS origin.
# PUBLIC_APP_URL="https://bsop-web.onrender.com"
# [OPTIONAL] Log verbosity: debug | info | warn | error (default info).
LOG_LEVEL="debug"
# [OPTIONAL] json | pretty (default json).
LOG_FORMAT="json"
# [OPTIONAL] Site code granted to seeded users (default BERT-01).
DEFAULT_SITE_CODE="BERT-01"

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# [REQUIRED] PostgreSQL connection string. Startup fails without it.
# Render injects this from the managed database — do not set it by hand there.
DATABASE_URL="postgresql://bsop:bsop_dev@localhost:5432/bsop_dev?schema=public"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# [REQUIRED] Signs every session token. Minimum 32 characters; startup fails on
# less. Render generates this — never reuse the development value in production.
JWT_SECRET="change-me-in-production-minimum-32-characters-long"
# [OPTIONAL] Access-token life (default 15m). Idle sessions refresh transparently.
JWT_ACCESS_EXPIRY="15m"
# [OPTIONAL] Refresh-token life (default 7d) — the real "logged in for" duration.
JWT_REFRESH_EXPIRY="7d"
# [DEV-ONLY] One-click role login, bypasses the password form. Refused outright
# when NODE_ENV=production regardless of this value; keep "false" everywhere else
# unless actively testing.
ALLOW_DEV_LOGIN="false"
# [DEV-ONLY] Test-data sandbox tooling. Same rule as above.
ALLOW_TEST_DATA_TOOLS="false"
# [DEV-ONLY] /dev/visual-qa design-review routes (synthetic data only).
ENABLE_VISUAL_QA="false"

# CR-2026-107 — required operational forms (Vehicle Inspection, Pre-Job
# Inspection). The API checks these at every start and creates whichever is
# missing, so a deployment cannot come up unable to inspect a vehicle no matter
# how it was built or which database it was pointed at. The check is idempotent,
# non-destructive, and writes nothing when the database is already correct.
#
# Set to "off" ONLY for a read-only replica or a forensic restore where no writes
# are wanted. Leaving it off means the inspection forms are not guaranteed.
# FORMS_BOOTSTRAP="off"

# ---------------------------------------------------------------------------
# Storage (inspection photographs)
# ---------------------------------------------------------------------------
# [OPTIONAL] Only "local" is implemented; any other value fails startup loudly so
# a misconfigured production instance cannot silently write to an ephemeral disk.
INSPECTION_PHOTO_DRIVER="local"
# [OPTIONAL] Directory for the local driver (default <cwd>/.data/inspection-photos).
# On a host with no persistent disk (Render free tier), photographs do NOT survive
# a redeploy — see docs/DEPLOYMENT.md §Storage before relying on them in production.
# INSPECTION_PHOTO_ROOT=""

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------
# [OPTIONAL] stub (default, no outbound traffic) | twilio | sendgrid.
NOTIFICATION_PROVIDER="stub"
# [PROD when NOTIFICATION_PROVIDER=twilio] — set in the host environment only.
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""
# TWILIO_MESSAGING_SERVICE_SID=""
# [CR-2026-096] TEST (default) redirects every customer send to the test
# recipients below; reaching REAL customers requires an explicit
# NOTIFICATION_MODE="LIVE" here. A real provider in TEST mode refuses to send
# at all unless a test recipient is configured.
NOTIFICATION_MODE="TEST"
# NOTIFICATION_TEST_SMS_TO=""
# NOTIFICATION_TEST_EMAIL_TO=""
# [CR-2026-099] Real email delivery through ANY SMTP mailbox (Microsoft 365,
# Google Workspace, a relay). stub (default) records messages without sending.
EMAIL_PROVIDER="stub"
# [PROD when EMAIL_PROVIDER=smtp] — set in the host environment only.
# SMTP_HOST=""
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="Bert's Service Centre <service@example.com>"

# ---------------------------------------------------------------------------
# Integrations
# ---------------------------------------------------------------------------
# [OPTIONAL] STUB (default, no outbound calls) | LIVE (NHTSA vPIC VIN decode).
VIN_DECODE_PROVIDER="STUB"

# ---------------------------------------------------------------------------
# Workers / queues
# ---------------------------------------------------------------------------
# [OPTIONAL] BullMQ is not wired in the current deployment; Redis is used by local
# development only (Socket.IO adapter falls back to in-process without it).
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# ---------------------------------------------------------------------------
# Frontend (baked into the web build — set BEFORE building)
# ---------------------------------------------------------------------------
# [PROD] Where the browser reaches the API. In production: https://<api-host>/api/v1
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
# [PROD] Where the browser reaches Socket.IO. In production: https://<api-host>
NEXT_PUBLIC_WS_URL="http://localhost:3001"

# ---------------------------------------------------------------------------
# Deployment metadata (set by the platform, not by people)
# ---------------------------------------------------------------------------
# [OPTIONAL] Render injects RENDER_GIT_COMMIT automatically; BUILD_COMMIT is the
# override for other hosts. Shown at /api/v1/health and in Admin → Deployment so
# the running site can be verified against the pushed commit.
# BUILD_COMMIT=""
# BUILD_TIMESTAMP=""
